// One cart tile (design: "Bubble main window design" canvas, Tile component):
//
//   ┌──────────────────────────────────────┐
//   │ 12  G1 Drums              C5  F1     │  number, group; MIDI note (outlined), hotkey
//   │            Label text                │  typeface, size and alignment from Display
//   │ [A] ×0.75 ↻ ⇥ +2             -1:23   │  output, speed, icons (the rest in +N); time
//   │▀▀▀▀▀▀▀▀▀▀▀▀▀▀────────────────────────│  progress bar (or a dial by the time, or none)
//   └──────────────────────────────────────┘
//
// Playing, the tile has a ring inside its edge: 1 px dark, 4 px state colour, 1 px
// dark, so it shows on a cart of the same colour. Selection and quick edit's ring sit
// outside, 1–4 px into the 6 px gap, so they never touch a neighbour.
//
// Input is reported, not acted on: the app decides what a press does in each mode.

import { Spinner } from "std-widgets.slint";
import { Theme, Clock } from "theme.slint";

export enum CartState { empty, loading, missing, error, ready, playing, stopping }

export struct Tile {
    has-cart: bool,
    // 1-based position on the page.
    number: int,
    label: string,
    bg: color,
    fg: color,
    group: string,
    // The hotkey keycap text.
    triggers: string,
    // The MIDI trigger ("C5"), in an outlined chip before the keycap.
    midi: string,
    // The output letter ("A"); empty for a control button.
    output: string,
    // The output is playing elsewhere or not set up here (amber badge).
    rerouted: bool,
    // Path commands (16 × 16 grid) for the icon row, most important first: those that
    // do not fit collapse into a "+N" chip.
    icons: [string],
    // For the "+N" chip's tip: entry k names the icons from k on ("Loop, Stop all").
    icon-tails: [string],
    // "×0.75" when the speed is not 100%.
    speed: string,
    time: string,
    // `time`, one string per character (see Clock).
    time-chars: [string],
    progress: float,
    ending: bool,
    state: CartState,
    selected: bool,
    learning: bool,
    // A control button (STOP GROUP, STOP PAGE, STOP ALL).
    control: bool,
    // Shown after a moment's hover (why the output is rerouted).
    tip: string,
    // Audio is being copied into this cell (the busy popover has the details).
    copying: bool,
}

// A cart label measured at one size, inside a clipped empty box so it is never drawn.
component LabelProbe inherits Text {
    wrap: word-wrap;
    accessible-role: none;
}

// The playing (or learning) ring, inside the tile's edge: 1 px dark, 4 px colour,
// 1 px dark, so it shows on a cart of the same colour.
component StateRing inherits Rectangle {
    in property <color> colour;
    in property <color> keyline;
    // Whole device pixels (see TileView's `dp`), so every edge is even.
    in property <length> k: 1px;
    in property <length> band: 4px;
    border-radius: 8px;
    border-width: root.k;
    border-color: keyline;
    Rectangle {
        x: root.k;
        y: root.k;
        width: parent.width - 2 * root.k;
        height: parent.height - 2 * root.k;
        border-radius: 8px - root.k;
        border-width: root.band;
        border-color: root.colour;
        Rectangle {
            x: root.band;
            y: root.band;
            width: parent.width - 2 * root.band;
            height: parent.height - 2 * root.band;
            border-radius: max(0px, 8px - root.k - root.band);
            border-width: root.k;
            border-color: root.keyline;
        }
    }
}

// How cart labels look (Session Settings ▸ Display).
export struct LabelStyle {
    font: string,
    weight: int,
    size: float,
    small: float,
    // 0 left/top, 1 centre, 2 right/bottom.
    h-align: int,
    v-align: int,
}

export component TileView inherits Rectangle {
    in property <Tile> tile;
    in property <LabelStyle> style;
    in property <bool> edit-mode;
    // Quick edit's ring marks this cart instead of the selection outline.
    in property <bool> ringed;
    // Files are dragged over it, or a cart is being moved onto it.
    in property <bool> drop-target;
    in property <color> drop-color: Theme.drop;
    // While playing: 0 a progress bar along the bottom, 1 a dial by the time, 2 the
    // countdown only (Settings ▸ General).
    in property <int> progress-style;
    // The window's scale factor, to put lines on whole device pixels.
    in property <float> scale: 1;

    // A press: right button, touch, and the modifiers held.
    callback down(bool /* right */, bool /* touch */, bool /* shift */, bool /* alt */, bool /* ctrl */);
    // Where the last press was (tile coordinates), for a menu at the pointer.
    out property <length> press-x;
    out property <length> press-y;
    callback up(bool /* touch */);
    // Touch in Edit mode: a tap (released before the hold time) or a press-and-hold.
    callback tap();
    callback hold();
    callback double();
    // The pointer moved while pressed (tile coordinates).
    callback dragged(length, length);
    callback released-at(length, length);
    callback show-tip(string, length, length);
    callback hide-tip();

    property <bool> holding;
    property <bool> held;
    property <bool> playing: tile.state == CartState.playing || tile.state == CartState.stopping;
    // The state colour: yellow playing, purple fading, red inside the ending warning.
    property <color> state-color: tile.state == CartState.stopping ? Theme.fading : tile.ending ? Theme.ending : Theme.playing;

    // 6 px clear of the 6 px playing ring at the sides, 4 px at the top.
    property <length> pad: 12px;
    property <length> top: 10px;
    // A length as whole device pixels, at least one: at 125 % a 1 px line is one device
    // pixel, not 1.25 (which blurs it unevenly from edge to edge).
    pure function dp(v: length) -> length {
        max(1px / root.scale, round(v * root.scale / 1px) * 1px / root.scale)
    }
    property <length> k: dp(1px);
    property <length> band: dp(4px);
    property <length> ring: 2 * self.k + self.band;
    property <length> bar-h: dp(8px);
    // The dark lines either side of the ring's colour, and the bar's.
    property <color> keyline: #000000cc;
    property <length> small: clamp(12px * style.small, 8px, 40px);
    property <length> time-size: clamp(clamp(self.height / 7, 14px, 22px) * style.small, 8px, 60px);
    property <length> label-size: clamp(clamp(self.height / 5, 13px, 26px) * style.size, 6px, 120px);
    // A long label steps down to the largest of these sizes that fits, no smaller than
    // 13 px (or the full size, if a small setting makes that smaller). Only the sizes
    // tried are measured: a short label measures one, and only again when it or the
    // tile changes.
    property <length> label-floor: min(label-size, 13px);
    property <length> label-w: root.width - 2 * pad;
    property <length> label-h: max(0px, bottom.y - 2px - (top + top-h + 2px));
    property <int> label-step: fit-0.preferred-height <= label-h ? 0
        : fit-1.preferred-height <= label-h ? 1
        : fit-2.preferred-height <= label-h ? 2
        : fit-3.preferred-height <= label-h ? 3
        : fit-4.preferred-height <= label-h ? 4
        : fit-5.preferred-height <= label-h ? 5
        : 6;
    pure function step-size(k: float) -> length {
        max(label-floor, label-size * k)
    }
    property <length> fitted-size: label-step == 0 ? step-size(1)
        : label-step == 1 ? step-size(0.85)
        : label-step == 2 ? step-size(0.7)
        : label-step == 3 ? step-size(0.6)
        : label-step == 4 ? step-size(0.55)
        : step-size(0.5);
    // Still too long at the smallest size: from the top, ending in an ellipsis.
    property <bool> label-too-long: label-step == 6;
    property <string> label-font: style.font != "" ? style.font : Theme.mac ? "System Font" : "";
    property <int> label-weight: tile.control ? 700 : max(style.weight, 600);
    property <length> label-spacing: tile.control ? 0.6px : 0px;
    // The bottom row ends here: its figures 7 px above the progress bar (ring 6 + bar
    // 8), or as far from the bottom as the top row is from the top. The row's box runs
    // below the figures' baseline (room for letters' tails, from the font), so it ends
    // that much lower. Kept while idle too, so nothing moves when a cart starts.
    property <length> descent: (max(18px, time-probe.preferred-height) - time-probe.font-metrics.ascent - time-probe.font-metrics.descent) / 2;
    property <length> bottom-y: (progress-style == 0 ? self.height - self.ring - self.bar-h - 7px : self.height - top) + descent;
    // The middle of the time's figures, in the bottom row: the badge, icons and chips
    // on the left are centred on it, so both sides of the row line up.
    property <length> fig-mid: bottom.height - descent - time-probe.font-metrics.cap-height / 2;
    property <bool> over-chip: icon-box.hidden > 0 && icon-box.chip-x + icon-box.chip-w <= icon-box.width && ta.has-hover
        && ta.mouse-x >= bottom.x + icon-box.x + icon-box.chip-x - 2px
        && ta.mouse-x <= bottom.x + icon-box.x + icon-box.chip-x + icon-box.chip-w + 2px
        && ta.mouse-y >= bottom.y - 2px && ta.mouse-y <= bottom.y + bottom.height + 2px;
    property <bool> tip-shown;
    changed over-chip => {
        root.tip-shown = false;
        if !self.over-chip {
            root.hide-tip();
        }
    }
    property <length> top-h: max(small + 4px, chips.preferred-height);

    border-radius: 8px;
    background: tile.has-cart ? tile.bg : Theme.empty-tile;

    // Empty cell in Edit mode: a "+" to show it can take audio.
    if !tile.has-cart && edit-mode && !tile.copying: Text {
        text: "+";
        font-size: 26px;
        font-weight: 300;
        color: Theme.empty-mark;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Audio arriving: an outline and a quiet icon; the busy popover has the words.
    if tile.copying: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.accent.transparentize(15%);
        Path {
            width: 22px;
            height: 22px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M8 2v7.5M5 6.5l3 3 3-3M2.5 10.5v2a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-2";
            stroke: #8fb0ff;
            stroke-width: 1.6px;
            fill: transparent;
        }
    }
    // The number of an empty cell.
    if !tile.has-cart: Text {
        x: pad;
        y: top;
        text: tile.number;
        font-size: small;
        color: Theme.empty-mark;
    }

    // A cart not ready yet (audio loading) or missing is dimmed; the rest is unchanged.
    content := Rectangle {
        visible: tile.has-cart;
        opacity: tile.state == CartState.missing || tile.state == CartState.error ? 0.5 : tile.state == CartState.loading ? 0.55 : 1;

        // ---- top row: number + group (left), hotkey keycap (right) ----
        chips := HorizontalLayout {
            x: pad;
            y: top;
            width: root.width - 2 * pad;
            height: self.preferred-height;
            spacing: 6px;
            Text {
                text: tile.number;
                font-size: small;
                color: tile.fg.transparentize(28%);
                vertical-alignment: center;
            }
            if tile.group != "": Rectangle {
                border-radius: 4px;
                background: tile.fg.transparentize(80%);
                horizontal-stretch: 0;
                min-width: group-text.preferred-width + 12px;
                group-text := Text {
                    text: tile.group;
                    font-size: small * 0.92;
                    color: tile.fg;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // The MIDI note: outlined, so it reads apart from the keycap after it.
            if tile.midi != "": Rectangle {
                border-radius: 4px;
                border-width: 1.5px;
                border-color: tile.fg.transparentize(15%);
                horizontal-stretch: 0;
                min-width: midi-text.preferred-width + 12px;
                midi-text := Text {
                    text: tile.midi;
                    font-size: small;
                    font-weight: 600;
                    color: tile.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // A prominent "keycap", so the operator can read the hotkey at a glance.
            if tile.triggers != "": Rectangle {
                border-radius: 4px;
                background: tile.fg.transparentize(12%);
                horizontal-stretch: 0;
                min-width: key-text.preferred-width + 12px;
                key-text := Text {
                    text: tile.triggers;
                    font-size: small;
                    font-weight: 600;
                    color: tile.bg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ---- bottom row: output badge, speed, icon row (left); time (right) ----
        bottom := HorizontalLayout {
            x: pad;
            width: root.width - 2 * pad;
            // One height whatever it holds (time, tag or spinner), so the label above
            // never moves.
            height: max(18px, time-probe.preferred-height);
            y: bottom-y - self.height;
            spacing: 5px;
            alignment: stretch;
            if tile.output != "": Rectangle {
                y: root.fig-mid - self.height / 2;
                height: small + 4px;
                min-width: max(self.height, out-text.preferred-width + 6px);
                horizontal-stretch: 0;
                border-radius: 4px;
                background: tile.rerouted ? Theme.rerouted : tile.fg.transparentize(76%);
                out-text := Text {
                    text: tile.output;
                    font-size: small * 0.92;
                    font-weight: 700;
                    color: tile.rerouted ? #000000 : tile.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if tile.speed != "": Rectangle {
                y: root.fig-mid - self.height / 2;
                height: small + 4px;
                min-width: speed-text.preferred-width + 10px;
                horizontal-stretch: 0;
                border-radius: 4px;
                background: tile.fg.transparentize(80%);
                speed-text := Text {
                    text: tile.speed;
                    font-size: small * 0.92;
                    font-weight: 600;
                    color: tile.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // The icons that fit, then "+N" for the rest.
            icon-box := Rectangle {
                horizontal-stretch: 1;
                property <length> icon: small + 2px;
                out property <length> slot: self.icon + 5px;
                out property <length> chip-w: small * 1.5 + 8px;
                property <int> count: tile.icons.length;
                property <int> fit: max(0, floor((self.width + 5px) / self.slot));
                out property <int> shown: self.count <= self.fit ? self.count : max(0, floor((self.width - self.chip-w) / self.slot));
                out property <int> hidden: self.count - self.shown;
                out property <length> chip-x: self.shown * self.slot;
                for icon[i] in tile.icons: Path {
                    visible: i < icon-box.shown;
                    x: i * icon-box.slot;
                    y: root.fig-mid - self.height / 2;
                    width: icon-box.icon;
                    height: icon-box.icon;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: icon;
                    stroke: tile.fg.transparentize(10%);
                    stroke-width: 1.5px;
                    fill: transparent;
                }
                // Only where it fits: the time comes first.
                if self.hidden > 0 && self.chip-x + self.chip-w <= self.width: Rectangle {
                    x: icon-box.chip-x;
                    y: root.fig-mid - self.height / 2;
                    width: icon-box.chip-w;
                    height: small + 4px;
                    border-radius: 4px;
                    background: tile.fg.transparentize(80%);
                    Text {
                        text: "+" + icon-box.hidden;
                        font-size: small * 0.92;
                        font-weight: 600;
                        color: tile.fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            // Not ready yet: a small spinner (the busy popover says why).
            if tile.state == CartState.loading: Spinner {
                y: root.fig-mid - self.height / 2;
                width: small + 2px;
                height: small + 2px;
                indeterminate: true;
            }
            // MISSING / ERROR as a small tag; otherwise the time.
            if tile.state == CartState.missing || tile.state == CartState.error: Rectangle {
                y: root.fig-mid - self.height / 2;
                height: small + 6px;
                min-width: tag.preferred-width + 12px;
                horizontal-stretch: 0;
                border-radius: 4px;
                background: #00000059;
                tag := Text {
                    text: tile.state == CartState.missing ? "MISSING" : "ERROR";
                    font-size: small * 0.92;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    color: #ffb4a8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // A ring by the time, filling clockwise from the top as the cart plays: a disc
            // (a conic gradient, drawn with the smooth edge of a rounded rectangle) with a
            // hole in the cart's colour. As tall as the figures and centred on them.
            if root.playing && root.progress-style == 1: Rectangle {
                property <angle> a: clamp(tile.progress, 0, 1) * 360deg;
                property <length> hole: root.dp(self.width * 0.6);
                y: root.fig-mid - self.height / 2;
                width: root.dp(time-probe.font-metrics.cap-height * 1.05);
                height: self.width;
                horizontal-stretch: 0;
                border-radius: self.width / 2;
                background: @conic-gradient(root.state-color 0deg, root.state-color self.a, root.keyline self.a, root.keyline 360deg);
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.hole;
                    height: parent.hole;
                    border-radius: self.width / 2;
                    background: tile.bg;
                }
            }
            // Digits in fixed cells, so the countdown never shifts as it changes.
            if tile.state != CartState.missing && tile.state != CartState.error: Clock {
                chars: tile.time-chars;
                size: time-size;
                weight: 600;
                colour: tile.fg;
                alignment: end;
                horizontal-stretch: 0;
            }
        }

        // The time's font, measured (never drawn): where its figures sit in the row.
        time-probe := Text {
            width: 0;
            text: "0";
            font-size: time-size;
            font-weight: 600;
            color: transparent;
            accessible-role: none;
        }

        // ---- label in the remaining area ("|" or Shift+Return is a line break) ----
        Text {
            x: pad;
            y: top + top-h + 2px;
            width: root.width - 2 * pad;
            height: max(0px, bottom.y - 2px - self.y);
            text: tile.label;
            // The large label in San Francisco's Display design, as macOS sets large
            // text (the window default is its Text design; fonts.rs).
            font-family: label-font;
            font-weight: label-weight;
            letter-spacing: label-spacing;
            font-size: fitted-size;
            color: tile.fg;
            wrap: word-wrap;
            overflow: label-too-long ? TextOverflow.elide : TextOverflow.clip;
            horizontal-alignment: style.h-align == 0 ? TextHorizontalAlignment.left : style.h-align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;
            vertical-alignment: label-too-long || style.v-align == 0 ? TextVerticalAlignment.top : style.v-align == 2 ? TextVerticalAlignment.bottom : TextVerticalAlignment.center;
        }
        // The label at each size, never drawn, to measure it.
        Rectangle {
            width: 0;
            height: 0;
            clip: true;
            fit-0 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(1);
            }
            fit-1 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(0.85);
            }
            fit-2 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(0.7);
            }
            fit-3 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(0.6);
            }
            fit-4 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(0.55);
            }
            fit-5 := LabelProbe {
                width: label-w;
                text: tile.label;
                font-family: label-font;
                font-weight: label-weight;
                letter-spacing: label-spacing;
                font-size: step-size(0.5);
            }
        }
    }

    // ---- state: the ring inside the edge, and the progress bar inside the ring ----
    if root.playing: StateRing {
        colour: root.state-color;
        keyline: root.keyline;
        k: root.k;
        band: root.band;
    }
    // Its bottom corners follow the ring's inner corners.
    if root.playing && root.progress-style == 0: Rectangle {
        x: root.ring;
        y: root.height - root.ring - root.bar-h;
        width: root.width - 2 * root.ring;
        height: root.bar-h;
        background: root.keyline;
        border-bottom-left-radius: max(0px, 8px - root.ring);
        border-bottom-right-radius: max(0px, 8px - root.ring);
        clip: true;
        // A dark track under a 1 px keyline; the ring's own keyline is below it.
        Rectangle {
            y: root.k;
            height: parent.height - root.k;
            background: #00000066;
            Rectangle {
                x: 0;
                width: parent.width * clamp(tile.progress, 0, 1);
                background: root.state-color;
            }
        }
    }
    // Selection (Edit mode) and the cart quick edit or Cart Setup is open for: outside
    // the edge, a 1 px line then a 2 px one, leaving 2 px of the gap clear.
    if (tile.selected && edit-mode) || ringed: Rectangle {
        property <length> out: root.dp(4px);
        property <length> outer: root.dp(2px);
        x: -self.out;
        y: -self.out;
        width: root.width + 2 * self.out;
        height: root.height + 2 * self.out;
        border-radius: 8px + self.out;
        border-width: self.outer;
        border-color: Theme.ring-outer;
        Rectangle {
            x: parent.outer;
            y: parent.outer;
            width: parent.width - 2 * parent.outer;
            height: parent.height - 2 * parent.outer;
            border-radius: 8px + parent.out - parent.outer;
            border-width: root.k;
            border-color: Theme.ring-inner;
        }
    }
    // Learning a trigger: the ring pulsing until a key or MIDI message arrives.
    if tile.learning: StateRing {
        colour: Theme.learning;
        keyline: root.keyline;
        k: root.k;
        band: root.band;
        opacity: 0.25 + 0.75 * abs(sin(animation-tick() / 1100ms * 180deg));
    }
    if drop-target: Rectangle {
        border-radius: 8px;
        border-width: 3px;
        border-color: root.drop-color;
    }

    // A touch press waits for release (tap) or the hold time. Only in Edit mode: in
    // Show mode touch plays on press like the mouse, for the lowest latency.
    hold-timer := Timer {
        interval: 500ms;
        running: root.holding;
        triggered => {
            root.holding = false;
            root.held = true;
            root.hold();
        }
    }
    // Over the "+N" chip: the icons it stands for; elsewhere the tile's own tip.
    tip-timer := Timer {
        interval: 600ms;
        running: ta.has-hover && !ta.pressed && !root.tip-shown && (root.over-chip || tile.tip != "");
        triggered => {
            root.tip-shown = true;
            root.show-tip(root.over-chip ? tile.icon-tails[icon-box.shown] : tile.tip, ta.mouse-x, ta.mouse-y);
        }
    }

    ta := TouchArea {
        changed has-hover => {
            if !self.has-hover {
                root.tip-shown = false;
                root.hide-tip();
            }
        }
        double-clicked => {
            root.double();
        }
        moved => {
            if self.pressed {
                if root.holding && (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) {
                    // A touch that moves is not a tap or a hold.
                    root.holding = false;
                    root.held = true;
                }
                root.dragged(self.mouse-x, self.mouse-y);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.hide-tip();
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                if e.button == PointerEventButton.right {
                    root.down(true, false, e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                } else if e.button == PointerEventButton.left {
                    if (e.touch-finger-id != 0) && root.edit-mode {
                        root.held = false;
                        root.holding = true;
                    } else {
                        root.down(false, (e.touch-finger-id != 0), e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                    }
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if e.button == PointerEventButton.right {
                    // Right-click acted on press.
                } else if root.holding {
                    root.holding = false;
                    if e.kind == PointerEventKind.up {
                        root.tap();
                    }
                } else if !root.held {
                    root.up((e.touch-finger-id != 0));
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.released-at(self.mouse-x, self.mouse-y);
                }
                root.held = false;
            }
        }
    }
}
