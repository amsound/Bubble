// Quick edit: the common cart settings in a popover inside the main window, beside the
// cart (design: "Quick edit: options as toggle buttons"). Opened by right-click,
// press-and-hold or Return in Edit mode; closed by Esc or a click outside it.
//
//   Button 8                         [Cart Setup…]
//   Label   [Morning⏎News          ]
//   Colour  ● ● ● ● ● ● ● ● ● ● | ◍
//   Gain    ───────●──────   +1.5 dB
//   Output  [A - Studio            ▾]
//   Fade Out[Default (1.5 s)       ▾]
//   Group   [None                  ▾]
//   Hotkey  [Learn]                F6
//   [↻ Loop] [⇥ Play Next] [■ Stop All]
//   [Copy] [Paste] [Replace File…]        [Delete]

import { Slider } from "std-widgets.slint";
import { Theme, TextCommand, Panel, SysButton, PopButton } from "theme.slint";

export struct QuickEdit {
    title: string,
    // A control button: no gain, output, fade or options.
    control: bool,
    show-group: bool,
    label: string,
    swatches: [color],
    // Index into `swatches`; -1 for any other colour.
    color: int,
    hex: string,
    gain: float,
    outputs: [string],
    output: int,
    fades: [string],
    fade: int,
    groups: [string],
    group: int,
    // The learned hotkey, drawn as on the tile; empty when there is none.
    hotkey: string,
    // The cart's colour (the keycap's text colour).
    cart-color: color,
    looping: bool,
    next: bool,
    stop-all: bool,
    can-paste: bool,
}

// The label: a plain multi-line field in the system font, telling the app when it
// has the keyboard.
component LabelField inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback edited(string);
    property <int> seq: TextCommand.seq;
    // One line, growing as the label wraps or gains lines.
    height: max(Theme.mac ? 22px : 32px, input.preferred-height + (Theme.mac ? 6px : 12px));
    border-radius: Theme.mac ? 5px : 4px;
    background: Theme.mac ? Theme.text.transparentize(90%) : Theme.window-bg;
    border-width: input.has-focus ? 2px : (Theme.mac ? 0px : 1px);
    border-color: input.has-focus ? (Theme.mac ? #0a84ff99 : #4cc2ff) : Theme.panel-border;
    clip: true;
    input := TextInput {
        x: 8px;
        y: Theme.mac ? 3px : 6px;
        width: parent.width - 16px;
        height: parent.height - (Theme.mac ? 6px : 12px);
        single-line: false;
        wrap: word-wrap;
        font-size: Theme.mac ? 13px : 14px;
        color: Theme.text;
        selection-background-color: Theme.accent;
        edited => {
            root.edited(self.text);
        }
        changed has-focus => {
            TextCommand.typing = self.has-focus;
        }
    }
    changed seq => {
        if input.has-focus {
            if TextCommand.name == "copy" {
                input.copy();
            } else if TextCommand.name == "cut" {
                input.cut();
            } else if TextCommand.name == "paste" {
                input.paste();
            } else if TextCommand.name == "select-all" {
                input.select-all();
            }
        }
    }
}

// A label column and its control, as one row.
component FieldRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    // Mac grouped-form rows carry their own inset; Windows rows sit on the flyout.
    padding-left: Theme.mac ? 10px : 0px;
    padding-right: Theme.mac ? 10px : 0px;
    padding-top: Theme.mac ? 6px : 0px;
    padding-bottom: Theme.mac ? 6px : 0px;
    Text {
        text: root.label;
        width: Theme.mac ? 64px : 72px;
        vertical-alignment: center;
        color: Theme.mac ? Theme.text.transparentize(22%) : Theme.weak-text;
    }
    @children
}

// A thin rule between rows of a group (Mac grouped form).
component Rule inherits Rectangle {
    height: 1px;
    Rectangle {
        x: 10px;
        width: parent.width - 10px;
        background: Theme.text.transparentize(92%);
    }
}

// A Mac grouped-form box; on Windows the rows sit straight on the flyout.
component Group inherits Rectangle {
    border-radius: Theme.mac ? 9px : 0px;
    background: Theme.mac ? Theme.text.transparentize(94%) : transparent;
    VerticalLayout {
        padding-top: Theme.mac ? 2px : 0px;
        padding-bottom: Theme.mac ? 2px : 0px;
        spacing: Theme.mac ? 0px : 6px;
        @children
    }
}

// Loop, Play Next, Stop All: toggle buttons with the tile's icons.
component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> on;
    callback toggled(bool);
    height: Theme.mac ? 30px : 40px;
    border-radius: Theme.mac ? 7px : 4px;
    background: on ? Theme.accent : ta.has-hover ? Theme.hover : Theme.mac ? Theme.text.transparentize(90%) : Theme.button;
    border-width: on || Theme.mac ? 0px : 1px;
    border-color: Theme.panel-border;
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Path {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: root.icon;
            stroke: root.on ? #ffffff : Theme.text;
            stroke-width: 1.6px;
            fill: transparent;
        }
        Text {
            text: root.text;
            color: root.on ? #ffffff : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
}

export component QuickEditPanel inherits Panel {
    in property <QuickEdit> qe;
    callback label(string);
    callback colour(int);
    callback gain(float);
    // "output", "fade" or "group": open its choices at (x, y) in the window.
    callback choice-menu(string, length, length);
    // "loop", "next" or "stop-all".
    callback flag(string, bool);
    // "done", "learn", "replace", "copy", "paste", "delete", "gain-reset" or
    // "pick-colour" (the system colour picker).
    callback action(string);

    // When the gain slider was last released (a double-click resets it).
    property <duration> gain-release: -1s;
    // The arrow points at the cart: on the left edge (panel right of the cart) or the
    // right edge, this far down.
    in property <bool> arrow-left: true;
    in property <length> arrow-y: 40px;

    // A quick fade in, as the system's popovers do.
    property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity {
        duration: 140ms;
        easing: ease-out;
    }
    init => {
        self.shown = true;
    }

    width: Theme.mac ? 392px : 404px;
    height: layout.preferred-height;
    border-radius: Theme.mac ? 12px : 8px;
    background: Theme.popover;

    // Clicks inside the panel must not reach the backdrop (which closes it).
    TouchArea { }

    // The arrow pointing at the cart (it fills the 10 px gap to the tile).
    Path {
        x: root.arrow-left ? -11px : root.width - 1px;
        y: clamp(root.arrow-y - 13px, 14px, root.height - 40px);
        width: 12px;
        height: 26px;
        viewbox-width: 12;
        viewbox-height: 26;
        commands: root.arrow-left ? "M12 0L0 13L12 26Z" : "M0 0L12 13L0 26Z";
        fill: Theme.popover;
        stroke: Theme.panel-border;
        stroke-width: 1px;
    }
    // Hides the arrow's stroke where it meets the panel.
    Rectangle {
        x: root.arrow-left ? 0px : root.width - 2px;
        y: clamp(root.arrow-y - 12px, 15px, root.height - 39px);
        width: 2px;
        height: 24px;
        background: Theme.popover;
    }

    layout := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: qe.title;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // Cart Setup is still in the egui interface.
            SysButton {
                text: "Cart Setup…";
                enabled: false;
            }
        }

        Group {
            FieldRow {
                label: "Label";
                VerticalLayout {
                    spacing: 3px;
                    LabelField {
                        text: qe.label;
                        edited(t) => {
                            root.label(t);
                        }
                    }
                }
            }
            if Theme.mac: Rule { }
            FieldRow {
                label: "Colour";
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    for c[i] in qe.swatches: Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.mac ? 10px : 4px;
                        background: c;
                        border-width: i == qe.color ? 2px : 0px;
                        border-color: Theme.text;
                        TouchArea {
                            clicked => {
                                root.colour(i);
                            }
                        }
                    }
                    Rectangle {
                        width: 1px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        background: Theme.panel-border;
                    }
                    // Any other colour.
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.mac ? 10px : 4px;
                        background: @radial-gradient(circle, #ffffff 0%, #ffffff 20%, transparent 21%);
                        Rectangle {
                            border-radius: parent.border-radius;
                            background: @linear-gradient(90deg, #ff3b30 0%, #ffcc00 25%, #34c759 45%, #0a84ff 70%, #bf5af2 100%);
                            border-width: qe.color < 0 ? 2px : 0px;
                            border-color: Theme.text;
                        }
                        // Any other colour, in the system colour picker.
                        TouchArea {
                            clicked => {
                                root.action("pick-colour");
                            }
                        }
                    }
                }
            }
        }

        Group {
            if !qe.control: FieldRow {
                label: "Gain";
                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 28px;
                    // 0 dB is in the middle of the range.
                    Rectangle {
                        x: parent.width / 2 - 0.5px;
                        y: 0;
                        width: 1px;
                        height: 5px;
                        background: Theme.weak-text;
                    }
                    gain-slider := Slider {
                        width: parent.width;
                        minimum: -12;
                        maximum: 12;
                        value: qe.gain;
                        changed(v) => {
                            root.gain(v);
                        }
                        // A double-click (two quick releases) goes back to 0 dB.
                        released => {
                            if animation-tick() - root.gain-release < 400ms {
                                self.value = 0;
                                root.action("gain-reset");
                            }
                            root.gain-release = animation-tick();
                        }
                    }
                }
                Text {
                    width: 58px;
                    text: (round(gain-slider.value * 10) > 0 ? "+" : "") + round(gain-slider.value * 10) / 10 + " dB";
                    color: Theme.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    TouchArea {
                        // Back to 0 dB.
                        double-clicked => {
                            gain-slider.value = 0;
                            root.action("gain-reset");
                        }
                    }
                }
            }
            if !qe.control && Theme.mac: Rule { }
            if !qe.control: FieldRow {
                label: "Output";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.outputs;
                    current-index: qe.output;
                    open(x, y) => {
                        root.choice-menu("output", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if !qe.control && Theme.mac: Rule { }
            if !qe.control: FieldRow {
                label: Theme.mac ? "Fade Out" : "Fade out";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.fades;
                    current-index: qe.fade;
                    open(x, y) => {
                        root.choice-menu("fade", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if qe.show-group && !qe.control && Theme.mac: Rule { }
            if qe.show-group: FieldRow {
                label: "Group";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.groups;
                    current-index: qe.group;
                    open(x, y) => {
                        root.choice-menu("group", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if Theme.mac: Rule { }
            FieldRow {
                label: "Hotkey";
                HorizontalLayout {
                    SysButton {
                        y: (parent.height - self.height) / 2;
                        text: "Learn";
                        clicked => {
                            root.action("learn");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // The hotkey as its keycap on the tile.
                    if qe.hotkey != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        min-width: key.preferred-width + 14px;
                        border-radius: 4px;
                        background: #ffffffe0;
                        key := Text {
                            text: qe.hotkey;
                            font-size: 12px;
                            font-weight: 600;
                            color: qe.cart-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if qe.hotkey == "": Text {
                        text: "none";
                        color: Theme.weak-text;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !qe.control: HorizontalLayout {
            spacing: 6px;
            Toggle {
                text: "Loop";
                icon: "M2.5 7.5a5 5 0 0 1 8.6-3.5M13.5 8.5a5 5 0 0 1-8.6 3.5M11.5 1.5v2.8H8.7M4.5 14.5v-2.8h2.8";
                on: qe.looping;
                toggled(on) => {
                    root.flag("loop", on);
                }
            }
            Toggle {
                text: Theme.mac ? "Play Next" : "Play next";
                icon: "M2.5 8h8M7.5 5l3 3-3 3M13 4v8";
                on: qe.next;
                toggled(on) => {
                    root.flag("next", on);
                }
            }
            Toggle {
                text: Theme.mac ? "Stop All" : "Stop all";
                icon: "M4.5 4.5h7v7h-7z";
                on: qe.stop-all;
                toggled(on) => {
                    root.flag("stop-all", on);
                }
            }
        }

        // Windows: a rule above the actions; the Mac popover has none.
        if !Theme.mac: Rectangle {
            height: 1px;
            background: Theme.panel-border;
        }
        HorizontalLayout {
            spacing: 6px;
            SysButton {
                text: "Copy";
                clicked => {
                    root.action("copy");
                }
            }
            SysButton {
                text: "Paste";
                enabled: qe.can-paste;
                clicked => {
                    root.action("paste");
                }
            }
            if !qe.control: SysButton {
                text: Theme.mac ? "Replace File…" : "Replace file…";
                clicked => {
                    root.action("replace");
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            SysButton {
                text: "Delete";
                destructive: true;
                clicked => {
                    root.action("delete");
                }
            }
        }
    }
}
