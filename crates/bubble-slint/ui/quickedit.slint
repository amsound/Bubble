// Quick edit: the common cart settings in a popover inside the main window, beside the
// cart (design: "Quick edit: options as toggle buttons"). Opened by right-click,
// press-and-hold or Return in Edit mode; closed by Esc or a click outside it.
//
//   Button 8                         [Cart Setup…]
//   Label   [Morning⏎News          ]
//   Colour  ● ● ● ● ● ● ● ● ● ● | ◍
//   Gain    ───────●──────   +1.5 dB
//   Output  [A - Studio            ▾]
//   Fade Out[Default (1.5 s)       ▾]
//   Group   [None                  ▾]
//   Hotkey  [Learn]                F6
//   [↻ Loop] [⇥ Play Next] [■ Stop All]
//   [Copy] [Paste] [Replace File…]        [Delete]

import { Theme, TextCommand, Panel, SysButton, PopButton, ClearX, SetupSlider } from "theme.slint";

export struct QuickEdit {
    title: string,
    // A control button: no gain, output, fade or options.
    control: bool,
    show-group: bool,
    label: string,
    swatches: [color],
    // Index into `swatches`; -1 for any other colour.
    color: int,
    hex: string,
    gain: float,
    outputs: [string],
    output: int,
    fades: [string],
    fade: int,
    groups: [string],
    group: int,
    // The learned hotkey, drawn as on the tile; empty when there is none.
    hotkey: string,
    // Learn is waiting for this cart's key or MIDI note.
    learning: bool,
    // The cart's colour (the keycap's text colour).
    cart-color: color,
    looping: bool,
    next: bool,
    stop-all: bool,
    can-paste: bool,
}

// The label: a plain multi-line field in the system font, telling the app when it
// has the keyboard.
export component LabelField inherits Rectangle {
    in-out property <string> text <=> input.text;
    // One line only (Return is `accepted`), or at least this many lines tall.
    in property <bool> single-line;
    in property <int> lines: 1;
    callback edited(string);
    callback accepted();
    property <int> seq: TextCommand.seq;
    // One line, growing as the label wraps or gains lines.
    height: single-line ? (Theme.mac ? 22px : 32px)
        : max((Theme.mac ? 16px : 20px) * lines + (Theme.mac ? 6px : 12px), input.preferred-height + (Theme.mac ? 6px : 12px));
    border-radius: Theme.mac ? 5px : 4px;
    background: Theme.mac ? Theme.text.transparentize(90%) : Theme.window-bg;
    border-width: input.has-focus ? 2px : (Theme.mac ? 0px : 1px);
    border-color: input.has-focus ? (Theme.mac ? #0a84ff99 : #4cc2ff) : Theme.panel-border;
    clip: true;
    input := TextInput {
        x: 8px;
        y: Theme.mac ? 3px : 6px;
        width: parent.width - 16px;
        height: parent.height - (Theme.mac ? 6px : 12px);
        single-line: root.single-line;
        wrap: root.single-line ? no-wrap : word-wrap;
        vertical-alignment: root.single-line ? center : top;
        font-size: Theme.mac ? 13px : 14px;
        color: Theme.text;
        selection-background-color: Theme.accent;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
        changed has-focus => {
            TextCommand.typing = self.has-focus;
        }
    }
    changed seq => {
        if input.has-focus {
            if TextCommand.name == "copy" {
                input.copy();
            } else if TextCommand.name == "cut" {
                input.cut();
            } else if TextCommand.name == "paste" {
                input.paste();
            } else if TextCommand.name == "select-all" {
                input.select-all();
            }
        }
    }
}

// A label column and its control, as one row.
export component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: Theme.mac ? 64px : 72px;
    spacing: 10px;
    // Mac grouped-form rows carry their own inset; Windows rows sit on the flyout.
    padding-left: Theme.mac ? 10px : 0px;
    padding-right: Theme.mac ? 10px : 0px;
    padding-top: Theme.mac ? 6px : 0px;
    padding-bottom: Theme.mac ? 6px : 0px;
    Text {
        text: root.label;
        width: root.label-width;
        vertical-alignment: center;
        color: Theme.mac ? Theme.text.transparentize(22%) : Theme.weak-text;
    }
    @children
}

// A thin rule between rows of a group (Mac grouped form).
export component Rule inherits Rectangle {
    height: 1px;
    Rectangle {
        x: 10px;
        width: parent.width - 10px;
        background: Theme.text.transparentize(92%);
    }
}

// A Mac grouped-form box; on Windows the rows sit straight on the flyout.
export component Group inherits Rectangle {
    border-radius: Theme.mac ? 9px : 0px;
    background: Theme.mac ? Theme.text.transparentize(94%) : transparent;
    VerticalLayout {
        padding-top: Theme.mac ? 2px : 0px;
        padding-bottom: Theme.mac ? 2px : 0px;
        spacing: Theme.mac ? 0px : 6px;
        @children
    }
}

// Loop, Play Next, Stop All: toggle buttons with the tile's icons.
export component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> on;
    callback toggled(bool);
    height: Theme.mac ? 30px : 40px;
    border-radius: Theme.mac ? 7px : 4px;
    background: on ? Theme.accent : ta.has-hover ? Theme.hover : Theme.mac ? Theme.text.transparentize(90%) : Theme.button;
    border-width: on || Theme.mac ? 0px : 1px;
    border-color: Theme.panel-border;
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon != "": Path {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: root.icon;
            stroke: root.on ? #ffffff : Theme.text;
            stroke-width: 1.6px;
            fill: transparent;
        }
        Text {
            text: root.text;
            color: root.on ? #ffffff : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
}

export component QuickEditPanel inherits Panel {
    in property <QuickEdit> qe;
    callback label(string);
    callback colour(int);
    callback gain(float);
    // "output", "fade" or "group": open its choices at (x, y) in the window.
    callback choice-menu(string, length, length);
    // "loop", "next" or "stop-all".
    callback flag(string, bool);
    // "done", "learn", "clear-key", "replace", "copy", "paste", "delete",
    // "gain-reset" or "setup" (Cart Setup).
    callback action(string);

    // The arrow points at the cart: on the left edge (panel right of the cart) or the
    // right edge, this far down.
    in property <bool> arrow-left: true;
    in property <length> arrow-y: 40px;

    // A quick fade in, as the system's popovers do.
    property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity {
        duration: 140ms;
        easing: ease-out;
    }
    init => {
        self.shown = true;
    }

    width: Theme.mac ? 392px : 404px;
    height: layout.preferred-height;
    border-radius: Theme.mac ? 12px : 8px;
    background: Theme.popover;

    // Clicks inside the panel must not reach the backdrop (which closes it).
    TouchArea { }

    // The arrow pointing at the cart (it fills the 10 px gap to the tile).
    Path {
        x: root.arrow-left ? -11px : root.width - 1px;
        y: clamp(root.arrow-y - 13px, 14px, root.height - 40px);
        width: 12px;
        height: 26px;
        viewbox-width: 12;
        viewbox-height: 26;
        commands: root.arrow-left ? "M12 0L0 13L12 26Z" : "M0 0L12 13L0 26Z";
        fill: Theme.popover;
        stroke: Theme.panel-border;
        stroke-width: 1px;
    }
    // Hides the arrow's stroke where it meets the panel.
    Rectangle {
        x: root.arrow-left ? 0px : root.width - 2px;
        y: clamp(root.arrow-y - 12px, 15px, root.height - 39px);
        width: 2px;
        height: 24px;
        background: Theme.popover;
    }

    layout := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        // Cart Setup… first, the cart's number on the right.
        HorizontalLayout {
            spacing: 6px;
            // A control button has nothing to set up.
            if !qe.control: SysButton {
                text: "Cart Setup…";
                clicked => {
                    root.action("setup");
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: qe.title;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        Group {
            FieldRow {
                label: "Label";
                VerticalLayout {
                    spacing: 3px;
                    LabelField {
                        text: qe.label;
                        edited(t) => {
                            root.label(t);
                        }
                    }
                }
            }
            if Theme.mac: Rule { }
            FieldRow {
                label: "Colour";
                // The swatches only (any other colour is in Cart Setup), on one line. On
                // Windows each is a 40 px touch target (Microsoft's minimum for touch).
                swatches := Rectangle {
                    property <length> size: Theme.mac ? 20px : 34px;
                    property <length> cell: Theme.mac ? 25px : 40px;
                    property <int> per-row: max(1, qe.swatches.length);
                    horizontal-stretch: 1;
                    height: ceil(qe.swatches.length / per-row) * cell;
                    for c[i] in qe.swatches: Rectangle {
                        x: mod(i, swatches.per-row) * swatches.cell;
                        y: floor(i / swatches.per-row) * swatches.cell;
                        width: swatches.cell;
                        height: swatches.cell;
                        Rectangle {
                            width: swatches.size;
                            height: swatches.size;
                            border-radius: Theme.mac ? self.width / 2 : 4px;
                            background: c;
                            border-width: i == qe.color ? 2px : 0px;
                            border-color: Theme.text;
                        }
                        TouchArea {
                            clicked => {
                                root.colour(i);
                            }
                        }
                    }
                }
            }
        }

        Group {
            if !qe.control: FieldRow {
                label: "Gain";
                // As tall as a drop-down on Windows, for a finger; a press on the track
                // jumps there and a double-click on the knob goes back to 0 dB.
                gain-slider := SetupSlider {
                    y: (parent.height - self.height) / 2;
                    centre-mark: true;
                    minimum: -12;
                    maximum: 12;
                    value: qe.gain;
                    changed(v) => {
                        root.gain(v);
                    }
                    reset => {
                        self.value = 0;
                        root.action("gain-reset");
                    }
                }
                Text {
                    width: 58px;
                    // As stored: within ±0.25 dB is exactly 0, else to 0.1 dB. Always one
                    // decimal, never "−0".
                    property <int> tenths: abs(gain-slider.value) < 0.25 ? 0 : round(gain-slider.value * 10);
                    text: self.tenths == 0 ? "0.0 dB" : (self.tenths > 0 ? "+" : "−") + floor(abs(self.tenths) / 10) + "." + mod(abs(self.tenths), 10) + " dB";
                    color: Theme.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    TouchArea {
                        // Back to 0 dB.
                        double-clicked => {
                            gain-slider.value = 0;
                            root.action("gain-reset");
                        }
                    }
                }
            }
            if !qe.control && Theme.mac: Rule { }
            if !qe.control: FieldRow {
                label: "Output";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.outputs;
                    current-index: qe.output;
                    open(x, y) => {
                        root.choice-menu("output", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if !qe.control && Theme.mac: Rule { }
            if !qe.control: FieldRow {
                label: Theme.mac ? "Fade Out" : "Fade out";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.fades;
                    current-index: qe.fade;
                    open(x, y) => {
                        root.choice-menu("fade", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if qe.show-group && !qe.control && Theme.mac: Rule { }
            if qe.show-group: FieldRow {
                label: "Group";
                PopButton {
                    y: (parent.height - self.height) / 2;
                    model: qe.groups;
                    current-index: qe.group;
                    open(x, y) => {
                        root.choice-menu("group", x, y);
                    }
                }
                if Theme.mac: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if Theme.mac: Rule { }
            FieldRow {
                label: "Hotkey";
                // As in Cart Setup: the keycap with its ✕, then Learn at the end.
                HorizontalLayout {
                    spacing: 6px;
                    // The hotkey as its keycap on the tile.
                    if qe.hotkey != "" && !qe.learning: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        min-width: key.preferred-width + 14px;
                        border-radius: 4px;
                        background: #ffffffe0;
                        key := Text {
                            text: qe.hotkey;
                            font-size: 12px;
                            font-weight: 600;
                            color: qe.cart-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if qe.learning: Text {
                        text: "Press a key or play a MIDI note…";
                        color: Theme.learning;
                        vertical-alignment: center;
                    }
                    if qe.hotkey != "" && !qe.learning: ClearX {
                        y: (parent.height - self.height) / 2;
                        label: "Clear Hotkey";
                        clicked => {
                            root.action("clear-key");
                        }
                    }
                    if qe.hotkey == "" && !qe.learning: Text {
                        text: "none";
                        color: Theme.weak-text;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    SysButton {
                        y: (parent.height - self.height) / 2;
                        text: qe.learning ? "Cancel" : "Learn";
                        clicked => {
                            root.action("learn");
                        }
                    }
                }
            }
        }

        if !qe.control: HorizontalLayout {
            spacing: 6px;
            Toggle {
                text: "Loop";
                icon: "M2.5 7.5a5 5 0 0 1 8.6-3.5M13.5 8.5a5 5 0 0 1-8.6 3.5M11.5 1.5v2.8H8.7M4.5 14.5v-2.8h2.8";
                on: qe.looping;
                toggled(on) => {
                    root.flag("loop", on);
                }
            }
            Toggle {
                text: Theme.mac ? "Play Next" : "Play next";
                icon: "M2.5 8h8M7.5 5l3 3-3 3M13 4v8";
                on: qe.next;
                toggled(on) => {
                    root.flag("next", on);
                }
            }
            Toggle {
                text: Theme.mac ? "Stop All" : "Stop all";
                icon: "M4.5 4.5h7v7h-7z";
                on: qe.stop-all;
                toggled(on) => {
                    root.flag("stop-all", on);
                }
            }
        }

        // Windows: a rule above the actions; the Mac popover has none.
        if !Theme.mac: Rectangle {
            height: 1px;
            background: Theme.panel-border;
        }
        HorizontalLayout {
            spacing: 6px;
            SysButton {
                text: "Copy";
                clicked => {
                    root.action("copy");
                }
            }
            SysButton {
                text: "Paste";
                enabled: qe.can-paste;
                clicked => {
                    root.action("paste");
                }
            }
            if !qe.control: SysButton {
                text: Theme.mac ? "Replace File…" : "Replace file…";
                clicked => {
                    root.action("replace");
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            SysButton {
                text: "Delete";
                destructive: true;
                clicked => {
                    root.action("delete");
                }
            }
        }
    }
}
