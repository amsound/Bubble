// Bubble's main window: menus, busy popover, cart wall, bottom bar, quick edit, popup
// menus. State comes from Rust (`src/app.rs`); input goes back as
// callbacks, and Rust decides what it does.

import { Palette, Spinner, ProgressIndicator, Button } from "std-widgets.slint";
import { Theme, TextCommand, FlatButton, Panel, PopupRow, SysButton } from "theme.slint";
import { TileView, Tile, LabelStyle, CartState } from "tile.slint";
import { BottomBar, PageTab, StatusItem } from "bar.slint";
import { QuickEditPanel, QuickEdit } from "quickedit.slint";
import { CartSetupWindow, SetupInfo, WaveMark } from "cartsetup.slint";
import { SettingsWindow, SessionSettingsWindow, OutputRow, PortRow, GroupRow, PageRow } from "settings.slint";

export { Theme, TextCommand, Tile, LabelStyle, CartState, PageTab, StatusItem, QuickEdit, PopupRow, CartSetupWindow, SetupInfo, WaveMark, SettingsWindow, SessionSettingsWindow, OutputRow, PortRow, GroupRow, PageRow }

// A menu entry; a separator has the separator title (see `src/menu.rs`).
export struct MenuEntryData {
    id: int,
    title: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    shortcut: keys,
}

// A run of entries, then (optionally) a submenu. Slint menus cannot choose between an
// item and a submenu per model row, so each top-level menu is a list of these.
export struct MenuSlot {
    items: [MenuEntryData],
    sub-title: string,
    sub: [MenuEntryData],
}

export struct MenuTop {
    title: string,
    slots: [MenuSlot],
}

// The loading dialog: a session on its way in, all input waiting.
export struct LoadInfo {
    // A session is loading: input is blocked, seen or not.
    modal: bool,
    // Past the first moment: a quick load shows nothing.
    shown: bool,
    title: string,
    detail: string,
    file: string,
    // 0…1, or -1 when unknown (a moving bar).
    progress: float,
    done: int,
    total: int,
    cancelling: bool,
    // There is something to cancel yet (not while Bubble itself is starting).
    can-cancel: bool,
    // The last input was by touch: a larger button.
    touch: bool,
}

// A line in the busy popover.
export struct BusyRow {
    text: string,
    detail: string,
    // Audio is being copied in (download icon); otherwise a spinner.
    copy: bool,
    // 0…1, or -1 when unknown (a moving bar).
    progress: float,
    // It can be stopped.
    can-cancel: bool,
}

// A context-menu entry; a separator has the separator title (see `src/menu.rs`).

export component MainWindow inherits Window {
    in property <string> window-title: "Bubble";
    in property <image> window-icon;
    title: window-title;
    icon: window-icon;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 420px;
    // The cart panel behind the carts (the page bar draws its own strip).
    background: Theme.cart-panel;
    // Slint's default falls to the generic sans-serif (Helvetica, Arial) before the
    // system face: the window names the system UI font, or (macOS) leaves it to the
    // San Francisco Text instances put first in the chain (fonts.rs).
    default-font-family: Theme.ui-font;
    // The size Windows 11 and macOS draw their own controls' text at; otherwise Slint
    // uses the system message font (12 px on Windows), smaller than our buttons.
    default-font-size: Theme.mac ? 13px : 14px;

    // ---- state from Rust ----
    in property <[MenuTop]> menus;
    in property <[Tile]> tiles;
    in property <int> rows: 4;
    in property <int> cols: 6;
    in property <LabelStyle> label-style: { font: "", weight: 400, size: 1, small: 1, h-align: 1, v-align: 1 };
    in property <bool> edit-mode: true;
    in property <[PageTab]> pages;
    in property <int> current-page;
    in property <[StatusItem]> status;
    in property <bool> status-clickable;
    in property <int> renaming: -1;
    in property <string> rename-text;
    in property <length> bar-height: 56px;
    // Page bar size (0 small, 1 medium, 2 large) and the + button's dashed outline.
    in property <int> bar-size;
    in property <string> plus-dashes;
    // The page bar at the top of the window, not the bottom (Settings ▸ General).
    in property <bool> bar-top;
    // Starting up: the cart wall stays empty with a progress ring and what is happening
    // ("Starting audio…", "Opening …", "Loading audio 3 of 32") until the session is
    // ready, then shows all at once.
    in property <bool> starting: true;
    // The window's scale factor (1, 1.25, 1.5, 2), set from Rust.
    in property <float> scale: 1;
    in property <[BusyRow]> busy;
    in property <LoadInfo> load;
    // The nearest whole device pixel.
    pure function pixel(v: length) -> length {
        round(v * root.scale / 1px) * 1px / root.scale
    }
    // Where the busy popover was dragged to, from top centre.
    property <length> busy-dx;
    property <length> busy-dy;
    // The cell files are dragged over (-1: none).
    in property <int> drop-index: -1;
    // Quick edit: shown while `qe-gen` has one entry; a new model rebuilds it.
    in property <[int]> qe-gen;
    in property <QuickEdit> qe;
    in property <length> qe-x;
    in property <length> qe-y;
    // Where the quick-edit arrow points (the cart's middle), and on which side.
    in property <length> qe-point-y;
    in property <bool> qe-arrow-left: true;
    // The cell quick edit belongs to, ringed while it is open.
    in property <int> qe-cell: -1;
    in property <[PopupRow]> popup-rows;
    in property <string> popup-sub-title;
    in property <[PopupRow]> popup-sub;
    in property <[PopupRow]> popup-tail;
    in property <length> popup-x;
    // The last press on a cell (window coordinates), where its menu opens.
    out property <length> press-x;
    out property <length> press-y;
    in property <length> popup-y;
    // Flipped to repaint the whole window (stale areas after a restore).
    in property <int> redraw-nonce;

    // ---- input to Rust ----
    callback menu-activated(int);
    callback cell-down(int, bool, bool, bool, bool, bool);
    callback cell-up(int, bool);
    callback cell-tap(int);
    callback cell-hold(int);
    callback cell-double(int);
    // Shift-drag (move) or Option/Alt-drag (copy) from one cell to another.
    callback cell-drop(int, int, bool);
    callback toggle-mode();
    callback cancel-job();
    callback select-page(int);
    callback start-rename(int);
    callback renamed(int, string);
    callback page-menu(int, length, length);
    callback move-page(int, int);
    callback add-page();
    callback stop-page();
    callback stop-all();
    callback status-clicked();
    callback popup-chosen(int);
    callback qe-close();
    callback qe-label(string);
    callback qe-colour(int);
    callback qe-gain(float);
    // A quick edit pop-up button was clicked: its field and where its menu opens.
    callback qe-choice-menu(string, length, length);
    callback qe-flag(string, bool);
    callback qe-action(string);

    // ---- layout ----
    property <length> gap: 6px;
    property <length> pad: 6px;
    property <length> wall-top: bar-top ? bar-height + pad : pad;
    property <length> wall-w: self.width - 2 * pad;
    property <length> wall-h: self.height - bar-height - 2 * pad;
    property <length> tile-w: max(40px, (wall-w - (cols - 1) * gap) / max(cols, 1));
    property <length> tile-h: max(30px, (wall-h - (rows - 1) * gap) / max(rows, 1));

    // Shift/Option drag of a cart.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <bool> drag-copy;

    // The standard widgets follow Bubble's appearance, not only the system's.
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <string> tip-text;
    property <length> tip-x;
    property <length> tip-y;

    // The cell at a point in the window (-1: none), for file drops and drags.
    public pure function cell-at(x: length, y: length) -> int {
        if x < pad || y < wall-top {
            return -1;
        }
        let c = floor((x - pad) / (tile-w + gap));
        let r = floor((y - wall-top) / (tile-h + gap));
        if c >= cols || r >= rows || x > pad + c * (tile-w + gap) + tile-w || y > wall-top + r * (tile-h + gap) + tile-h {
            return -1;
        }
        r * cols + c
    }
    public pure function cell-x(i: int) -> length {
        root.pixel(pad + mod(i, max(cols, 1)) * (tile-w + gap))
    }
    public pure function cell-w() -> length {
        tile-w
    }
    public pure function cell-h() -> length {
        tile-h
    }
    public pure function cell-y(i: int) -> length {
        root.pixel(wall-top + floor(i / max(cols, 1)) * (tile-h + gap))
    }
    public function open-popup() {
        ctx.show({ x: root.popup-x, y: root.popup-y });
    }
    public function close-popup() {
        ctx.close();
    }
    public function text-command(name: string) {
        TextCommand.name = name;
        TextCommand.seq += 1;
    }

    MenuBar {
        for top in root.menus: Menu {
            title: top.title;
            for it in top.slots[0].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[0].sub-title != "": Menu {
                title: top.slots[0].sub-title;
                for it in top.slots[0].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
            for it in top.slots[1].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[1].sub-title != "": Menu {
                title: top.slots[1].sub-title;
                for it in top.slots[1].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
            for it in top.slots[2].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[2].sub-title != "": Menu {
                title: top.slots[2].sub-title;
                for it in top.slots[2].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
            for it in top.slots[3].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[3].sub-title != "": Menu {
                title: top.slots[3].sub-title;
                for it in top.slots[3].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
            for it in top.slots[4].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[4].sub-title != "": Menu {
                title: top.slots[4].sub-title;
                for it in top.slots[4].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
            for it in top.slots[5].items: MenuItem {
                title: it.title;
                enabled: it.enabled;
                checkable: it.checkable;
                checked: it.checked;
                shortcut: it.shortcut;
                activated => {
                    root.menu-activated(it.id);
                }
            }
            if top.slots[5].sub-title != "": Menu {
                title: top.slots[5].sub-title;
                for it in top.slots[5].sub: MenuItem {
                    title: it.title;
                    enabled: it.enabled;
                    checkable: it.checkable;
                    checked: it.checked;
                    activated => {
                        root.menu-activated(it.id);
                    }
                }
            }
        }
    }

    // ---- cart wall ----
    for t[i] in tiles: TileView {
        // Each edge on a whole device pixel, so tiles and their text stay sharp; gaps may
        // differ by a pixel when the window does not divide evenly.
        property <length> left: pad + mod(i, max(cols, 1)) * (tile-w + gap);
        property <length> top: wall-top + floor(i / max(cols, 1)) * (tile-h + gap);
        x: root.pixel(self.left);
        y: root.pixel(self.top);
        width: root.pixel(self.left + tile-w) - self.x;
        height: root.pixel(self.top + tile-h) - self.y;
        tile: t;
        style: root.label-style;
        edit-mode: root.edit-mode;
        ringed: i == root.qe-cell && root.qe-gen.length > 0;
        drop-target: i == root.drop-index || (root.drag-from >= 0 && i == root.drag-to && i != root.drag-from);
        drop-color: root.drag-from >= 0 ? Theme.select : Theme.drop;
        down(right, touch, shift, alt, ctrl) => {
            root.press-x = self.x + self.press-x;
            root.press-y = self.y + self.press-y;
            if !right && root.edit-mode && t.has-cart && (shift || alt) {
                root.drag-from = i;
                root.drag-to = i;
                root.drag-copy = alt && !shift;
            }
            root.cell-down(i, right, touch, shift, alt, ctrl);
        }
        up(touch) => {
            root.cell-up(i, touch);
        }
        tap => {
            root.cell-tap(i);
        }
        hold => {
            // The cell's menu opens where the finger is (the press may not have set it).
            root.press-x = self.x + self.press-x;
            root.press-y = self.y + self.press-y;
            root.cell-hold(i);
        }
        double => {
            root.cell-double(i);
        }
        dragged(x, y) => {
            if root.drag-from >= 0 {
                root.drag-to = root.cell-at(self.x + x, self.y + y);
            }
        }
        released-at(x, y) => {
            if root.drag-from >= 0 {
                let to = root.cell-at(self.x + x, self.y + y);
                if to >= 0 && to != root.drag-from {
                    root.cell-drop(root.drag-from, to, root.drag-copy);
                }
                root.drag-from = -1;
                root.drag-to = -1;
            }
        }
        show-tip(text, x, y) => {
            root.tip-text = text;
            root.tip-x = self.x + x;
            root.tip-y = self.y + y;
        }
        hide-tip => {
            root.tip-text = "";
        }
    }

    // ---- start-up: the wall stays blank until there is a session to show (the busy
    // popover says what is happening, as it does at any other time) ----
    if root.starting: Rectangle {
        x: pad;
        y: wall-top;
        width: wall-w;
        height: wall-h;
        background: Theme.cart-panel;
        // Nothing underneath can be pressed meanwhile.
        TouchArea { }
    }

    // ---- busy popover: the one place for "Bubble is busy" ----
    // Non-modal, in the middle, over the wall (a session loading has its own dialog): ready carts stay playable underneath and
    // nothing moves. It goes when the work is done; drag it anywhere out of the way.
    if busy.length > 0: Rectangle {
        property <bool> shown;
        init => {
            self.shown = true;
        }
        opacity: self.shown ? 1 : 0;
        animate opacity {
            duration: 160ms;
            easing: ease-out;
        }
        width: min(460px, root.width - 24px);
        height: busy-layout.preferred-height;
        x: root.pixel(clamp((root.width - self.width) / 2 + root.busy-dx, 0px, max(0px, root.width - self.width)));
        // In the middle of the cart wall, where it is noticed.
        y: root.pixel(clamp(wall-top + (wall-h - self.height) / 2 + root.busy-dy, 0px, max(0px, root.height - self.height)));
        border-radius: 8px;
        background: Theme.popover;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000080;
        // Dragged by any part of it (the place is kept for next time).
        TouchArea {
            mouse-cursor: self.pressed ? grabbing : grab;
            moved => {
                if self.pressed {
                    root.busy-dx += self.mouse-x - self.pressed-x;
                    root.busy-dy += self.mouse-y - self.pressed-y;
                }
            }
        }
        busy-layout := VerticalLayout {
            padding: 16px;
            spacing: 14px;
            for row[i] in busy: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    height: Theme.mac ? 22px : 32px;
                    if !row.copy && Theme.mac: Spinner {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        indeterminate: true;
                    }
                    if row.copy && Theme.mac: Path {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M8 2v7.5M5 6.5l3 3 3-3M2.5 10.5v2a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-2";
                        stroke: #8fb0ff;
                        stroke-width: 1.6px;
                        fill: transparent;
                    }
                    Text {
                        text: row.text;
                        font-weight: i == 0 ? 600 : 400;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: row.detail;
                        color: Theme.weak-text;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if row.can-cancel: SysButton {
                        y: (parent.height - self.height) / 2;
                        text: "Cancel";
                        clicked => {
                            root.cancel-job();
                        }
                    }
                }
                // Progress, as Windows draws it: a thin bar in the accent, filled to how far
                // it has got when that is known, a moving piece otherwise.
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.control-border.transparentize(40%);
                    clip: true;
                    property <float> phase: mod(animation-tick() / 1400ms, 1);
                    Rectangle {
                        x: row.progress >= 0 ? 0 : (parent.width * 1.35) * phase - parent.width * 0.35;
                        width: row.progress >= 0 ? parent.width * clamp(row.progress, 0, 1) : parent.width * 0.35;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
        }
    }

    BottomBar {
        unit: 1px / root.scale;
        size: root.bar-size;
        plus-dashes: root.plus-dashes;
        at-top: root.bar-top;
        x: 0;
        // On a whole device pixel, so the join with the carts lands on a pixel edge.
        y: root.bar-top ? 0 : round((root.height - root.bar-height) * root.scale / 1px) * 1px / root.scale;
        width: root.width;
        height: root.bar-top ? root.bar-height : root.height - self.y;
        // No tabs before there is a session: they would only be the empty one's.
        pages: root.starting ? [] : root.pages;
        current: root.current-page;
        edit-mode: root.edit-mode;
        status: root.status;
        status-clickable: root.status-clickable;
        renaming: root.renaming;
        rename-text: root.rename-text;
        toggle-mode => {
            root.toggle-mode();
        }
        select-page(i) => {
            root.select-page(i);
        }
        start-rename(i) => {
            root.start-rename(i);
        }
        renamed(i, t) => {
            root.renamed(i, t);
        }
        page-menu(i, x, y) => {
            root.page-menu(i, self.x + x, self.y + y);
        }
        move-page(a, b) => {
            root.move-page(a, b);
        }
        add-page => {
            root.add-page();
        }
        stop-page => {
            root.stop-page();
        }
        stop-all => {
            root.stop-all();
        }
        status-clicked => {
            root.status-clicked();
        }
    }

    // ---- loading dialog: blocks everything until a session is in, or is cancelled.
    // The menu bar is the system's, so it is disabled, not covered. ----
    if root.load.modal: Rectangle {
        property <bool> shown: root.load.shown;
        background: Theme.dark ? #00000073 : #00000059;
        opacity: self.shown ? 1 : 0;
        animate opacity {
            duration: 120ms;
        }
        TouchArea {
            // Nothing beneath it can be pressed, or scrolled.
            scroll-event(e) => {
                accept
            }
        }
        Rectangle {
            width: 360px;
            height: load-layout.preferred-height;
            x: root.pixel((parent.width - self.width) / 2);
            // Centred on the cart wall, not on the window with the page bar.
            y: root.pixel((root.bar-top ? root.bar-height : 0px) + (root.height - root.bar-height - self.height) / 2);
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            border-radius: 8px;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.dark ? #0000008c : #141e324d;
            accessible-role: groupbox;
            accessible-label: root.load.title;
            load-layout := VerticalLayout {
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.load.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.load.detail;
                            font-size: 13px;
                            color: Theme.weak-text;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.dark ? #4a505b : #cdd3dc;
                        clip: true;
                        accessible-role: progress-indicator;
                        accessible-value-minimum: 0;
                        accessible-value-maximum: root.load.total;
                        accessible-value: root.load.done;
                        property <float> phase: mod(animation-tick() / 1400ms, 1);
                        Rectangle {
                            x: root.load.progress >= 0 ? 0 : (parent.width * 1.35) * parent.phase - parent.width * 0.35;
                            width: root.load.progress >= 0 ? parent.width * clamp(root.load.progress, 0, 1) : parent.width * 0.35;
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: root.load.file;
                        font-size: 13px;
                        min-height: 18px;
                        color: Theme.weak-text;
                        overflow: elide;
                    }
                }
                if root.load.can-cancel: Rectangle {
                    height: 1px;
                    background: Theme.card-border;
                }
                if root.load.can-cancel: HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    alignment: end;
                    SysButton {
                        text: root.load.cancelling ? "Cancelling…" : "Cancel";
                        enabled: !root.load.cancelling;
                        pad: 16px;
                        height: root.load.touch ? 40px : 32px;
                        clicked => {
                            root.cancel-job();
                        }
                        // It has the keyboard: Enter or Esc presses it.
                        if !root.load.cancelling: Rectangle {
                            x: -4px;
                            y: -4px;
                            width: parent.width + 8px;
                            height: parent.height + 8px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Theme.accent;
                        }
                    }
                }
            }
        }
    }

    // ---- quick edit ----
    for g in qe-gen: Rectangle {
        // A click outside closes it, and does nothing else; a right-click (or
        // Control-click) on another cell goes on to open that cell's quick edit or menu.
        // By touch, a tap outside closes it, and a press-and-hold on another cell opens
        // that cell's quick edit or menu, as a right-click does.
        property <int> hold-cell: -1;
        property <length> hold-x;
        property <length> hold-y;
        hold-timer := Timer {
            interval: 500ms;
            running: false;
            triggered => {
                self.running = false;
                root.press-x = parent.hold-x;
                root.press-y = parent.hold-y;
                let i = parent.hold-cell;
                root.qe-close();
                root.cell-hold(i);
                parent.hold-cell = -1;
            }
        }
        TouchArea {
            pointer-event(e) => {
                let touch = e.touch-finger-id != 0;
                if e.kind == PointerEventKind.down {
                    let i = root.cell-at(self.mouse-x, self.mouse-y);
                    if touch && e.button == PointerEventButton.left && i >= 0 {
                        parent.hold-cell = i;
                        parent.hold-x = self.mouse-x;
                        parent.hold-y = self.mouse-y;
                        hold-timer.running = true;
                        return;
                    }
                    root.qe-close();
                    if i >= 0 && (e.button == PointerEventButton.right || (Theme.mac && e.modifiers.control)) {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        root.cell-down(i, e.button == PointerEventButton.right, false, e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                    }
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && parent.hold-cell >= 0 {
                    // Lifted before the hold time: a tap, which closes quick edit.
                    hold-timer.running = false;
                    parent.hold-cell = -1;
                    root.qe-close();
                }
            }
            moved => {
                if parent.hold-cell >= 0 && (abs(self.mouse-x - parent.hold-x) > 12px || abs(self.mouse-y - parent.hold-y) > 12px) {
                    // A finger that moves is not a hold: it closes quick edit on lifting.
                    hold-timer.running = false;
                }
            }
        }
        // The double ring, inside the cart's own edge: it never touches a neighbour.
        Rectangle {
            property <length> outer: root.pixel(3px);
            property <length> inner: root.pixel(2px);
            x: root.cell-x(root.qe-cell);
            y: root.cell-y(root.qe-cell);
            width: root.pixel(pad + mod(root.qe-cell, max(cols, 1)) * (tile-w + gap) + tile-w) - self.x;
            height: root.pixel(wall-top + floor(root.qe-cell / max(cols, 1)) * (tile-h + gap) + tile-h) - self.y;
            border-radius: 8px;
            border-width: self.outer;
            border-color: Theme.ring-outer;
            Rectangle {
                x: parent.outer;
                y: parent.outer;
                width: parent.width - 2 * parent.outer;
                height: parent.height - 2 * parent.outer;
                border-radius: 8px - parent.outer;
                border-width: parent.inner;
                border-color: Theme.ring-inner;
            }
        }
        QuickEditPanel {
            // On whole device pixels: half a pixel off blurs every edge and word inside.
            x: root.pixel(clamp(root.qe-x, 8px, max(8px, root.width - self.width - 8px)));
            // Centred on the cart; near the top or bottom, level with the wall's edge.
            property <length> top: wall-top;
            property <length> bottom: wall-top + wall-h;
            y: root.pixel(clamp(root.qe-point-y - self.height / 2, self.top, max(self.top, self.bottom - self.height)));
            arrow-left: root.qe-arrow-left;
            arrow-y: root.qe-point-y - self.y;
            qe: root.qe;
            label(t) => {
                root.qe-label(t);
            }
            colour(i) => {
                root.qe-colour(i);
            }
            gain(v) => {
                root.qe-gain(v);
            }
            choice-menu(f, x, y) => {
                root.qe-choice-menu(f, x, y);
            }
            flag(f, on) => {
                root.qe-flag(f, on);
            }
            action(a) => {
                root.qe-action(a);
            }
        }
    }

    // ---- tooltip ----
    if tip-text != "": Rectangle {
        x: clamp(root.tip-x + 12px, 4px, max(4px, root.width - self.width - 4px));
        y: clamp(root.tip-y + 18px, 4px, max(4px, root.height - self.height - 4px));
        width: min(360px, tip.preferred-width + 16px);
        height: tip.preferred-height + 10px;
        border-radius: 4px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-border;
        tip := Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.tip-text;
            wrap: word-wrap;
            color: Theme.text;
            font-size: 12px;
        }
    }

    // ---- context menus (empty cells, page tabs): native NSMenu / Win32 menus ----
    // Opened from Rust (right-click, Control-click or press-and-hold), so the area
    // itself never opens one.
    ctx := ContextMenuArea {
        enabled: false;
        Menu {
            for it in root.popup-rows: MenuItem {
                title: it.text;
                enabled: it.enabled;
                checkable: it.checked;
                checked: it.checked;
                activated => {
                    root.popup-chosen(it.id);
                }
            }
            if root.popup-sub-title != "": Menu {
                title: root.popup-sub-title;
                for it in root.popup-sub: MenuItem {
                    title: it.text;
                    enabled: it.enabled;
                    activated => {
                        root.popup-chosen(it.id);
                    }
                }
            }
            for it in root.popup-tail: MenuItem {
                title: it.text;
                enabled: it.enabled;
                activated => {
                    root.popup-chosen(it.id);
                }
            }
        }
    }

    // Repaints the whole window when the nonce changes (see `redraw-nonce`).
    Rectangle {
        visible: mod(root.redraw-nonce, 2) == 1;
        background: #00000001;
    }
}
