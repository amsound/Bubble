// Colours, light and dark, and the small building blocks every part of the window uses.

import { LineEdit } from "std-widgets.slint";

// A row of a native menu (context menus, pop-up buttons).
export struct PopupRow {
    id: int,
    text: string,
    enabled: bool,
    // A pop-up button's current choice.
    checked: bool,
}

export global Theme {
    // 0 follow the system, 1 light, 2 dark (`Prefs.appearance`).
    in-out property <int> appearance;
    // Set from the window system's theme (winit), kept current while running.
    in-out property <bool> system-dark: true;
    out property <bool> dark: appearance == 2 || (appearance == 0 && system-dark);

    out property <color> window-bg: dark ? #1b1d21 : #eceef1;
    out property <color> bar-bg: dark ? #24272c : #dde1e6;
    out property <color> empty-tile: dark ? #363a40 : #d5dae0;
    out property <color> empty-mark: dark ? #6a7078 : #8a929c;
    out property <color> button: dark ? #3a3f46 : #c7cdd5;
    out property <color> button-hover: dark ? #454b53 : #d3d8de;
    out property <color> text: dark ? #e8e8e8 : #1c1f23;
    out property <color> weak-text: dark ? #9aa0a6 : #5f6670;
    out property <color> panel: dark ? #2b2f35 : #fbfbfc;
    out property <color> panel-border: dark ? #474d55 : #c5cad1;
    out property <color> hover: dark ? #3d434b : #e3e7ec;

    out property <color> accent: #2f6bff;
    out property <color> current-tab: #2f5f9a;
    out property <color> stop-all: #b02020;
    out property <color> edit-mode: #f09a2a;
    out property <color> show-mode: #3cb371;
    out property <color> warn: #f09a2a;
    out property <color> error: #e53935;
    out property <color> select: #80c0ff;
    out property <color> playing: #ffd82e;
    out property <color> ending: #ff5a3c;
    out property <color> fading: #a855f7;
    out property <color> learning: #ff40ff;
    out property <color> drop: #ffff00;
    out property <color> rerouted: #ffb020;

    // Running on macOS (set from Rust): Mac shapes and sizes, else Windows ones.
    in-out property <bool> mac;
    // The window's default font family (fonts.rs).
    in-out property <string> ui-font;
    // Quick edit and the busy popover. Dark: Cart Setup's background, so the same
    // controls look the same in both.
    out property <color> popover: dark ? window-bg : (mac ? #f6f6f7 : #f9f9f9);
}

// Copy, cut, paste, undo, redo and select-all from the menus, for whichever text
// field has the keyboard (the macOS menu takes ⌘C etc. before the field sees them).
export global TextCommand {
    in-out property <int> seq;
    in-out property <string> name;
    // A text field has the keyboard: hot keys and arrow keys leave it alone.
    in-out property <bool> typing;
}

// A text field that tells the app when it has the keyboard.
export component Field inherits LineEdit {
    // The field gained or lost the keyboard.
    callback focus-changed(bool);
    property <int> seq: TextCommand.seq;
    changed has-focus => {
        TextCommand.typing = self.has-focus;
        self.focus-changed(self.has-focus);
    }
    changed seq => {
        if self.has-focus {
            if TextCommand.name == "copy" {
                self.copy();
            } else if TextCommand.name == "cut" {
                self.cut();
            } else if TextCommand.name == "paste" {
                self.paste();
            } else if TextCommand.name == "undo" {
                self.undo();
            } else if TextCommand.name == "redo" {
                self.redo();
            } else if TextCommand.name == "select-all" {
                self.select-all();
            }
        }
    }
}

// A flat button sized for touch, never taking the keyboard (so Space and Return stay
// hot keys).
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.button;
    in property <color> text-color: Theme.text;
    in property <length> font-size: 14px;
    in property <bool> bold: true;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    border-radius: 5px;
    preferred-width: label.preferred-width + 24px;
    min-height: 28px;
    background: !enabled ? fill.transparentize(50%) : ta.pressed ? fill.darker(25%) : ta.has-hover ? fill.brighter(12%) : fill;
    label := Text {
        text: root.text;
        color: root.enabled ? root.text-color : root.text-color.transparentize(50%);
        font-size: root.font-size;
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 8px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A dialog or panel frame.
export component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.panel-border;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000070;
}

// A flat, system-like push button (Slint's own Mac style draws gradients). Mac: 24 px,
// translucent grey, the main button solid blue. Windows 11: 32 px, outlined, the main
// button in the accent colour with dark text.
// A pop-up button: the current choice and a chevron. A click asks for the choices
// (`open`, with where the menu goes in the window), shown as a native menu.
export component PopButton inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    callback open(length, length);
    property <bool> mac: Theme.mac;
    height: mac ? 22px : 32px;
    // A Mac pop-up button is as wide as its choice; Windows fills the row.
    horizontal-stretch: mac ? 0 : 1;
    preferred-width: row.preferred-width;
    max-width: mac ? row.preferred-width : 100000px;
    border-radius: mac ? 5px : 4px;
    background: ta.pressed ? Theme.text.transparentize(mac ? 78% : 86%) : mac ? Theme.text.transparentize(88%) : Theme.button;
    border-width: mac ? 0px : 1px;
    border-color: Theme.panel-border;
    row := HorizontalLayout {
        padding-left: mac ? 9px : 11px;
        padding-right: mac ? 7px : 11px;
        spacing: 8px;
        Text {
            text: root.model[root.current-index];
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Path {
            width: mac ? 9px : 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            viewbox-width: mac ? 9 : 12;
            viewbox-height: 12;
            // Mac: the up/down chevron of a pop-up button; Windows: a drop-down chevron.
            commands: mac ? "M1.5 4.5L4.5 1.5L7.5 4.5M1.5 7.5L4.5 10.5L7.5 7.5" : "M2 4L6 8L10 4";
            stroke: Theme.text.transparentize(25%);
            stroke-width: 1.3px;
            fill: transparent;
        }
    }
    ta := TouchArea {
        clicked => {
            // A Mac pop-up menu opens over its button (so it never runs off the bottom);
            // Windows opens it below.
            root.open(root.absolute-position.x, Theme.mac ? root.absolute-position.y : root.absolute-position.y + root.height + 3px);
        }
    }
}

// A time whose digits keep their place as they change: each character in its own
// cell (Slint draws no tabular figures). `chars` from Rust, one string per character.
export component Clock inherits HorizontalLayout {
    in property <[string]> chars;
    in property <length> size: 17px;
    in property <int> weight: 400;
    in property <color> colour: Theme.text;
    spacing: 0;
    for c in root.chars: Text {
        text: c;
        width: (c == ":" || c == ".") ? root.size * 0.3 : (c == "−" || c == "-") ? root.size * 0.48 : root.size * 0.62;
        font-size: root.size;
        font-weight: root.weight;
        color: root.colour;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SysButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    // Red text on a red tint (Delete).
    in property <bool> destructive;
    callback clicked;
    height: Theme.mac ? 24px : 32px;
    min-width: label.preferred-width + (Theme.mac ? 22px : 24px);
    horizontal-stretch: 0;
    border-radius: Theme.mac ? 6px : 4px;
    border-width: Theme.mac || primary ? 0px : 1px;
    border-color: Theme.panel-border;
    background: destructive ? (ta.has-hover ? #ff453a40 : #ff453a2e)
        : primary ? (Theme.mac ? #0a84ff : #4cc2ff).darker(ta.pressed ? 15% : 0%)
        : Theme.mac ? Theme.text.transparentize(ta.pressed ? 76% : ta.has-hover ? 82% : 87%)
        : ta.has-hover ? Theme.hover : Theme.button;
    opacity: enabled ? 1 : 0.45;
    label := Text {
        text: root.text;
        font-size: Theme.mac ? 13px : 14px;
        color: root.destructive ? #ff6961 : root.primary ? (Theme.mac ? #ffffff : #000000) : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A small round ✕ that clears the thing beside it.
export component ClearX inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: ta.pressed ? Theme.text.transparentize(65%) : ta.has-hover ? Theme.text.transparentize(75%) : Theme.text.transparentize(85%);
    accessible-role: button;
    accessible-label: label;
    Path {
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: "M1 1L7 7M7 1L1 7";
        stroke: Theme.text;
        stroke-width: 1.4px;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A slider drawn like the system's (a Mac slider, or Windows 11's with its accent dot).
// Pressing the track jumps there; the knob drags from where it was taken. Two presses
// on the knob within 400 ms (a double-click, or a double tap on a touch screen) put it
// back to its default (`reset`); on the track they only move it. With `log-scale` the
// middle of the track is the geometric mean (Speed: 25% · 100% · 400%). With
// `centre-mark`, a short line marks the middle (0 dB, centre pan, 100%).
export component SetupSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> log-scale;
    in property <bool> centre-mark;
    callback changed(float);
    callback reset();
    property <float> pos: clamp(log-scale ? log(value / minimum, 2) / log(maximum / minimum, 2) : (value - minimum) / (maximum - minimum), 0, 1);
    property <length> knob: Theme.mac ? 18px : 20px;
    property <length> knob-x: (self.width - knob) * pos;
    property <length> grab;
    // When the knob was last pressed (a second press soon after resets), and a reset
    // happening: the rest of that press does not move the knob.
    property <duration> knob-down-at: -10s;
    property <bool> resetting;
    // Windows: as tall as a drop-down (32 px), a finger's target; the Mac's is smaller.
    height: Theme.mac ? 22px : 32px;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-value: value;

    function set-from(x: length) {
        let p = clamp((x - root.grab) / max(1px, root.width - root.knob), 0, 1);
        let v = root.log-scale ? root.minimum * pow(root.maximum / root.minimum, p) : root.minimum + p * (root.maximum - root.minimum);
        root.value = v;
        root.changed(v);
    }

    Rectangle {
        x: root.knob / 2;
        width: root.width - root.knob;
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.transparentize(Theme.mac ? 80% : 60%);
    }
    if root.centre-mark: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 12px;
        background: Theme.text.transparentize(45%);
    }
    Rectangle {
        x: root.knob / 2;
        width: root.knob-x;
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.mac ? #0a84ff : Theme.accent;
    }
    Rectangle {
        x: root.knob-x;
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.width / 2;
        background: Theme.mac ? #f2f2f2 : (Theme.dark ? #454545 : #ffffff);
        border-width: Theme.mac ? 0px : 1px;
        border-color: Theme.panel-border;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000070;
        if !Theme.mac: Rectangle {
            width: ta.pressed ? 10px : ta.has-hover ? 14px : 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent;
            animate width { duration: 100ms; }
        }
    }
    ta := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                // A finger is wider than the pointer: the knob is easier to hit by touch.
                let slack = e.touch-finger-id != 0 ? 10px : 2px;
                let on-knob = self.mouse-x >= root.knob-x - slack && self.mouse-x <= root.knob-x + root.knob + slack;
                root.resetting = false;
                if on-knob {
                    if animation-tick() - root.knob-down-at < 400ms {
                        root.knob-down-at = -10s;
                        root.resetting = true;
                        root.reset();
                    } else {
                        root.knob-down-at = animation-tick();
                        root.grab = self.mouse-x - root.knob-x;
                    }
                } else {
                    root.knob-down-at = -10s;
                    root.grab = root.knob / 2;
                    root.set-from(self.mouse-x);
                }
            }
        }
        moved => {
            if self.pressed && !root.resetting {
                root.set-from(self.mouse-x);
            }
        }
    }
}
