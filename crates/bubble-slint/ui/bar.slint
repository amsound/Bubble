// The page bar, at the bottom of the window or the top (Settings ▸ General), to the
// settled design in docs/pagebar-spec.md:
//   [page tabs…] [+] [status, in the flexible space] [EDIT] | [PAGE STOP] [ALL STOP]
// The page shown is fused to the cart panel: the panel's colour, touching its edge,
// with a 3 px bar in the system accent. The other tabs are recessed 6 px, outlined,
// all one width. A red dot marks a page with something playing. EDIT is an outlined
// toggle, filled when on; PAGE STOP and ALL STOP are the only filled controls.
// Everything sits on the bar's centre line. Sizes come from the bar size (small,
// medium, large), as in the spec's table.

import { Theme, Field } from "theme.slint";

export struct PageTab {
    name: string,
    // Something on the page is playing (a yellow bar along the top).
    playing: bool,
}

export struct StatusItem {
    text: string,
    error: bool,
    // Information, not a warning (audio being prepared).
    info: bool,
}

component Tab inherits Rectangle {
    in property <PageTab> page;
    in property <bool> current;
    // The bar is at the top of the window: the carts are below the tab.
    in property <bool> at-top;
    // From the size table: tab text size, the red dot's diameter.
    in property <length> text-size;
    in property <length> dot;
    callback select();
    callback rename();
    callback menu(length, length);
    // Dragging: the pointer's x in the tab, and the drop.
    callback drag(length);
    callback drop(length);

    property <bool> dragging;
    property <bool> holding;
    property <bool> held;
    // The active tab is 6 px taller, toward the cart panel; its text sits where an
    // inactive tab's would, on the bar's centre line.
    property <length> inset: current ? 6px : 0px;
    property <length> r: 8px;
    background: current ? Theme.cart-panel : Theme.tab-off;
    border-width: current ? 0px : 1px;
    border-color: Theme.tab-off-border;
    border-top-left-radius: current && !at-top ? 0 : r;
    border-top-right-radius: current && !at-top ? 0 : r;
    border-bottom-left-radius: current && at-top ? 0 : r;
    border-bottom-right-radius: current && at-top ? 0 : r;
    clip: true;
    accessible-role: button;
    accessible-label: page.name + (page.playing ? ", playing" : "");
    accessible-checkable: true;
    accessible-checked: current;
    // The active tab's sides: a 1 px outline round its shape, with the edge facing the
    // carts pushed out of view (no line there). The accent bar covers the outer edge.
    if root.current: Rectangle {
        y: root.at-top ? 0 : -1px;
        height: parent.height + 1px;
        border-width: 1px;
        border-color: Theme.tab-off-border;
        border-top-left-radius: root.at-top ? root.r : 0;
        border-top-right-radius: root.at-top ? root.r : 0;
        border-bottom-left-radius: root.at-top ? 0 : root.r;
        border-bottom-right-radius: root.at-top ? 0 : root.r;
    }
    // The active tab's accent: 3 px along its outer edge.
    if root.current: Rectangle {
        y: root.at-top ? 0 : parent.height - self.height;
        height: 3px;
        background: Theme.accent;
    }
    // The name: centred, up to two lines, then clipped.
    one-line := Text {
        visible: false;
        text: "Ag";
        font-size: root.text-size;
    }
    Rectangle {
        x: 10px;
        y: root.at-top ? 0 : root.inset;
        width: parent.width - 20px;
        height: parent.height - root.inset;
        clip: true;
        Text {
            width: parent.width;
            height: min(self.preferred-height, 2 * one-line.preferred-height);
            y: (parent.height - self.height) / 2;
            text: page.name;
            wrap: word-wrap;
            overflow: clip;
            color: root.current ? Theme.tab-on-text : Theme.tab-off-text;
            font-size: root.text-size;
            font-weight: root.current ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
    }
    // Something is playing on this page: a red dot, top right.
    if page.playing: Rectangle {
        x: parent.width - 8px - root.dot / 2;
        y: (root.at-top ? 0 : root.inset) + 8px - root.dot / 2;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: Theme.tab-dot;
    }
    Timer {
        interval: 500ms;
        running: root.holding;
        triggered => {
            root.holding = false;
            root.held = true;
            root.menu(ta.mouse-x, ta.mouse-y);
        }
    }
    ta := TouchArea {
        double-clicked => {
            root.rename();
        }
        moved => {
            if self.pressed && !root.held {
                if !root.dragging && abs(self.mouse-x - self.pressed-x) > 8px {
                    root.dragging = true;
                    root.holding = false;
                }
                if root.dragging {
                    root.drag(self.mouse-x);
                }
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if e.button == PointerEventButton.right {
                    root.menu(self.mouse-x, self.mouse-y);
                } else if e.button == PointerEventButton.left {
                    root.dragging = false;
                    root.held = false;
                    root.holding = e.touch-finger-id != 0;
                }
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if root.dragging {
                    root.drop(self.mouse-x);
                } else if !root.held {
                    root.select();
                }
                root.dragging = false;
                root.holding = false;
                root.held = false;
            } else if e.kind == PointerEventKind.cancel {
                root.dragging = false;
                root.holding = false;
                root.held = false;
            }
        }
    }
}


// A bar button: EDIT (an outlined toggle), PAGE STOP and ALL STOP. Uppercase, bold,
// spaced; the stops have a square icon.
component BarButton inherits Rectangle {
    in property <string> text;
    in property <length> text-size;
    in property <length> pad;
    in property <length> icon;
    in property <color> fill;
    in property <color> line;
    in property <length> line-width;
    in property <color> ink;
    in property <bool> checkable;
    in property <bool> checked;
    callback clicked();
    border-radius: 8px;
    background: ta.pressed ? fill.darker(20%) : ta.has-hover && fill.alpha > 0 ? fill.brighter(8%) : fill;
    border-width: line-width;
    border-color: line;
    accessible-role: button;
    accessible-label: text;
    accessible-checkable: checkable;
    accessible-checked: checked;
    preferred-width: row.preferred-width;
    row := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        alignment: center;
        if root.icon > 0: Rectangle {
            width: root.icon;
            height: root.icon;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.ink;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: root.text-size;
            font-weight: 700;
            letter-spacing: root.text-size * 0.06;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component BottomBar inherits Rectangle {
    in property <[PageTab]> pages;
    in property <int> current;
    in property <bool> edit-mode;
    in property <[StatusItem]> status;
    // The page being renamed (-1: none) and its name when the rename began.
    in property <int> renaming: -1;
    in property <string> rename-text;
    // Missing files are listed in the status: clicking it opens Relink.
    in property <bool> status-clickable;
    // 0 small, 1 medium, 2 large (Settings ▸ General ▸ Page Bar Size).
    in property <int> size;
    // The + button's dashed outline, as a path for a `tab-h` square (from Rust).
    in property <string> plus-dashes;

    callback toggle-mode();
    callback select-page(int);
    callback start-rename(int);
    callback renamed(int, string);
    callback page-menu(int, length, length);
    callback move-page(int, int);
    callback add-page();
    callback stop-page();
    callback stop-all();
    callback status-clicked();

    background: Theme.strip;

    // One physical pixel (1px / the window's scale): tabs sit on whole pixels, so
    // their names stay sharp at 125% and 150%.
    in property <length> unit: 1px;
    // At the top of the window (the carts below it), not the bottom.
    in property <bool> at-top;

    // ---- the size table (docs/pagebar-spec.md) ----
    property <length> tab-h: size == 0 ? 44px : size == 1 ? 56px : 68px;
    property <length> btn-h: size == 0 ? 36px : size == 1 ? 44px : 52px;
    property <length> tab-w-full: size == 0 ? 108px : 112px;
    property <length> tab-text: size == 0 ? 13px : size == 1 ? 15px : 17px;
    property <length> btn-text: size == 0 ? 12px : size == 1 ? 14px : 15px;
    property <length> btn-pad: size == 0 ? 14px : 16px;
    property <length> stop-icon: size == 0 ? 10px : 12px;
    property <length> dot: size == 0 ? 7px : size == 1 ? 8px : 9px;

    // ---- geometry ----
    property <length> side: 12px;
    property <length> gap: 8px;
    // The bar's height is tab-h + 12 (set by the window); its centre line is half that.
    property <length> btn-y: (self.height - btn-h) / 2;
    // Inactive tabs and + are recessed 6 px from the cart panel's edge.
    property <length> off-y: 6px;
    // From the right: ALL STOP, PAGE STOP, the divider (4 px extra each side), EDIT.
    property <length> stop-x: self.width - side - stop-btn.preferred-width;
    property <length> page-x: stop-x - gap - page-btn.preferred-width;
    property <length> divider-x: page-x - gap - 4px - 1px;
    property <length> edit-x: divider-x - 4px - gap - edit-btn.preferred-width;
    // The tabs from the left; they shrink together when they do not fit.
    property <length> plus-w: edit-mode ? tab-h + gap : 0px;
    property <length> tabs-avail: max(40px, edit-x - gap - side - plus-w);
    property <length> tab-w: floor(min(tab-w-full, (tabs-avail - (pages.length - 1) * gap) / max(pages.length, 1)) / unit) * unit;
    property <length> step: tab-w + gap;
    property <length> tabs-end: side + pages.length * step - gap;
    // Where a dragged tab would land (-1: not dragging).
    property <int> drag-from: -1;
    property <int> drag-to: -1;

    // On whole device pixels at any display scale (125%, 150%…), so edges and text
    // stay sharp.
    pure function snap(v: length) -> length {
        round(v / unit) * unit
    }

    for p[i] in pages: Rectangle {
        x: round((side + i * step) / unit) * unit;
        // The page shown touches the cart panel: at the bar's top edge (bar at the
        // bottom of the window) or its bottom edge (bar at the top).
        y: snap(i == root.current ? (root.at-top ? off-y : 0px) : off-y);
        width: tab-w;
        height: snap(i == root.current ? tab-h + 6px : tab-h);
        if i != root.renaming: Tab {
            page: p;
            current: i == root.current;
            at-top: root.at-top;
            text-size: root.tab-text;
            dot: root.dot;
            select => {
                root.select-page(i);
            }
            rename => {
                root.start-rename(i);
            }
            menu(x, y) => {
                root.page-menu(i, parent.x + x, parent.y + y);
            }
            drag(x) => {
                root.drag-from = i;
                root.drag-to = clamp(floor((parent.x + x - side + step / 2) / step), 0, pages.length);
            }
            drop(x) => {
                if root.drag-to >= 0 {
                    root.move-page(i, root.drag-to > i ? root.drag-to - 1 : root.drag-to);
                }
                root.drag-from = -1;
                root.drag-to = -1;
            }
        }
        if i == root.renaming: Field {
            // The whole tab, so the name being typed is visible.
            width: parent.width;
            height: parent.height;
            text: root.rename-text;
            font-size: root.tab-text;
            min-width: 0;
            init => {
                self.focus();
                self.select-all();
            }
            accepted(t) => {
                root.renamed(i, t);
            }
            focus-changed(f) => {
                if !f && root.renaming == i {
                    root.renamed(i, self.text);
                }
            }
        }
    }
    // Where a dragged tab will land.
    if drag-from >= 0 && drag-to >= 0: Rectangle {
        z: 2;
        x: side + drag-to * step - gap / 2 - 1.5px;
        y: off-y;
        width: 3px;
        height: tab-h;
        background: Theme.select;
    }
    // Add page (Edit mode): a tab-high square with a dashed outline.
    if edit-mode: Rectangle {
        x: snap(tabs-end + gap);
        y: snap(off-y);
        width: tab-h;
        height: tab-h;
        border-radius: 8px;
        background: plus-ta.has-hover ? Theme.tab-off : transparent;
        accessible-role: button;
        accessible-label: "Add page";
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            commands: root.plus-dashes;
            stroke: Theme.tab-off-border;
            stroke-width: 1px;
            fill: transparent;
        }
        Path {
            width: 14px;
            height: 14px;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: "M7 0V14M0 7H14";
            stroke: Theme.tab-off-text;
            stroke-width: 1.6px;
        }
        plus-ta := TouchArea {
            clicked => {
                root.add-page();
            }
        }
    }

    // Status line, in the flexible space, only when there is something to say.
    if status.length > 0: Rectangle {
        x: (edit-mode ? tabs-end + gap + tab-h : tabs-end) + gap;
        y: btn-y;
        width: max(0px, edit-x - gap - self.x);
        height: btn-h;
        clip: true;
        HorizontalLayout {
            alignment: end;
            spacing: 0;
            for s[i] in status: HorizontalLayout {
                if i > 0: Text {
                    text: "  ·  ";
                    font-size: 12px;
                    color: Theme.weak-text;
                    vertical-alignment: center;
                }
                Text {
                    text: s.text;
                    font-size: 12px;
                    color: s.error ? Theme.error : s.info ? Theme.weak-text : Theme.warn;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        TouchArea {
            enabled: root.status-clickable;
            mouse-cursor: root.status-clickable ? pointer : default;
            clicked => {
                root.status-clicked();
            }
        }
    }

    // EDIT: outlined when off (Show mode), filled when on.
    edit-btn := BarButton {
        x: snap(edit-x);
        y: snap(btn-y);
        width: snap(self.preferred-width);
        height: snap(btn-h);
        text: "EDIT";
        text-size: btn-text;
        pad: btn-pad;
        fill: edit-mode ? Theme.edit-on : transparent;
        line: Theme.edit-line;
        line-width: 2px;
        ink: edit-mode ? Theme.edit-on-text : Theme.edit-off-text;
        checkable: true;
        checked: edit-mode;
        clicked => {
            root.toggle-mode();
        }
    }
    Rectangle {
        x: snap(divider-x);
        y: snap((parent.height - self.height) / 2);
        width: 1px;
        height: snap(round(btn-h * 0.6 / 1px) * 1px);
        background: Theme.bar-divider;
    }
    page-btn := BarButton {
        x: snap(page-x);
        y: snap(btn-y);
        width: snap(self.preferred-width);
        height: snap(btn-h);
        text: "PAGE STOP";
        text-size: btn-text;
        pad: btn-pad;
        icon: stop-icon;
        fill: Theme.page-stop;
        line: Theme.page-stop-line;
        line-width: 1px;
        ink: Theme.page-stop-text;
        clicked => {
            root.stop-page();
        }
    }
    stop-btn := BarButton {
        x: snap(stop-x);
        y: snap(btn-y);
        width: snap(self.preferred-width);
        height: snap(btn-h);
        text: "ALL STOP";
        text-size: btn-text;
        pad: btn-pad;
        icon: stop-icon;
        fill: Theme.all-stop;
        line: transparent;
        line-width: 0px;
        ink: #ffffff;
        clicked => {
            root.stop-all();
        }
    }
}
