// Quick edit: the common cart settings in a popover inside the main window, beside the
// cart (window design pass, 2026-10-29). Opened by right-click, press-and-hold or Return
// in Edit mode; closed by Esc or a click outside it. One 72 px label column, 36 px rows.
//
//   ● Button 8
//   Label     [Morning News                     ]
//   Colour    ■ ■ ■ ■ ■ ■ ■ ■
//   Gain      ───────●──────            +1.5 dB
//   Output    [Output A - Studio              ▾]
//   Fade out  [Default (1.5 s)                ▾]
//   Group     [None                           ▾]
//   Hotkey    [F6 ✕]                     [Learn]
//   Playback  [✓ Loop]          [Play next]
//   ─────────────────────────────────────────────
//   [⧉] [📋]    [≡ Cart setup…]                [🗑]

import { Theme, TextCommand, Panel, SysButton, PopButton, ClearX, SetupSlider } from "theme.slint";

export struct QuickEdit {
    title: string,
    // A control button: no gain, output, fade or options.
    control: bool,
    show-group: bool,
    label: string,
    swatches: [color],
    // Index into `swatches`; -1 for any other colour.
    color: int,
    hex: string,
    gain: float,
    outputs: [string],
    output: int,
    fades: [string],
    fade: int,
    groups: [string],
    group: int,
    // The learned hotkey; empty when there is none.
    hotkey: string,
    // The cart's output is a letter this computer has not set up.
    output-warn: bool,
    // Learn is waiting for this cart's key or MIDI note.
    learning: bool,
    // The cart's colour (the keycap's text colour).
    cart-color: color,
    looping: bool,
    next: bool,
    stop-all: bool,
    can-paste: bool,
}

// The label: a plain multi-line field in the system font, telling the app when it
// has the keyboard.
export component LabelField inherits Rectangle {
    in-out property <string> text <=> input.text;
    // One line only (Return is `accepted`), or at least this many lines tall.
    in property <bool> single-line;
    in property <int> lines: 1;
    // Faint words shown while it is empty ("Name").
    in property <string> placeholder;
    callback edited(string);
    callback accepted();
    property <int> seq: TextCommand.seq;
    // One line: how far the text is scrolled left, following the cursor. A bare
    // TextInput does not do this itself.
    property <length> scroll;
    // One line, growing as the label wraps or gains lines.
    height: single-line ? (Theme.mac ? 22px : 32px)
        : max((Theme.mac ? 16px : 20px) * lines + (Theme.mac ? 6px : 12px), input.preferred-height + (Theme.mac ? 6px : 12px));
    border-radius: Theme.mac ? 5px : 4px;
    background: Theme.mac ? Theme.text.transparentize(90%) : Theme.field;
    border-width: input.has-focus ? 2px : (Theme.mac ? 0px : 1px);
    border-color: input.has-focus ? (Theme.mac ? Theme.accent.transparentize(40%) : Theme.accent) : Theme.control-border;
    clip: true;
    if root.placeholder != "" && input.text == "": Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.placeholder;
        font-size: Theme.mac ? 13px : 14px;
        color: Theme.weak-text;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        property <length> view: parent.width - 16px;
        x: 8px + (root.single-line ? min(0px, max(self.view - self.width, root.scroll)) : 0px);
        y: Theme.mac ? 3px : 6px;
        width: root.single-line ? max(self.view, self.preferred-width + 2px) : self.view;
        height: parent.height - (Theme.mac ? 6px : 12px);
        single-line: root.single-line;
        wrap: root.single-line ? no-wrap : word-wrap;
        vertical-alignment: root.single-line ? center : top;
        font-size: Theme.mac ? 13px : 14px;
        color: Theme.text;
        selection-background-color: Theme.accent;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
        cursor-position-changed(p) => {
            if root.single-line {
                if p.x + root.scroll < 0px {
                    root.scroll = -p.x;
                } else if p.x + root.scroll > self.view - 2px {
                    root.scroll = self.view - 2px - p.x;
                }
            }
        }
        changed has-focus => {
            TextCommand.typing = self.has-focus;
            // Back to the start of the text once done with it.
            if !self.has-focus {
                root.scroll = 0px;
            }
        }
    }
    changed seq => {
        if input.has-focus {
            if TextCommand.name == "copy" {
                input.copy();
            } else if TextCommand.name == "cut" {
                input.cut();
            } else if TextCommand.name == "paste" {
                input.paste();
            } else if TextCommand.name == "select-all" {
                input.select-all();
            }
        }
    }
}

// A learned hotkey or MIDI note in a chip, with a ✕ that clears it.
export component KeyChip inherits Rectangle {
    in property <string> text;
    in property <string> clear-label;
    callback clear();
    height: 32px;
    preferred-width: chip.preferred-width;
    max-width: chip.preferred-width;
    min-width: 0;
    border-radius: 4px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-border;
    chip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.text;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: root.clear-label;
            Path {
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M1 1L9 9M9 1L1 9";
                stroke: Theme.text;
                stroke-width: 1.5px;
            }
            TouchArea {
                clicked => {
                    root.clear();
                }
            }
        }
    }
}

// A label column and its control, as one row.
export component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 64px;
    // Inside a Mac grouped box, rows carry their own inset; elsewhere none.
    in property <bool> grouped: true;
    spacing: 12px;
    // One row height throughout (the window design pass): 36 px, controls 32 px.
    // Never squeezed below a control's height (a long page scrolls instead).
    min-height: Theme.mac && grouped ? 34px : 36px;
    padding-left: Theme.mac && grouped ? 10px : 0px;
    padding-right: Theme.mac && grouped ? 10px : 0px;
    padding-top: Theme.mac && grouped ? 6px : 0px;
    // A layout puts a 32 px control at the top of the row, so the label centres on that.
    padding-bottom: Theme.mac && grouped ? 6px : Theme.mac ? 0px : 4px;
    Text {
        text: root.label;
        // Never cut short: a label longer than the column widens its row.
        width: max(root.label-width, self.preferred-width);
        vertical-alignment: center;
        color: Theme.mac ? Theme.text.transparentize(22%) : Theme.weak-text;
    }
    @children
}

// A card: a titled group on its own surface (Cart Setup's Sound and Cart, the
// settings windows' sections).
export component Card inherits Rectangle {
    in property <string> title;
    // Space above and below the rows, and between them (Cart Setup is tighter).
    in property <length> pad-y: 12px;
    in property <length> gap: 4px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    border-radius: 8px;
    VerticalLayout {
        padding: 16px;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;
        if root.title != "": Text {
            text: root.title;
            font-weight: 600;
            color: Theme.text;
            height: 28px;
            vertical-alignment: center;
        }
        @children
    }
}

// A thin rule between rows of a group (Mac grouped form).
export component Rule inherits Rectangle {
    height: 1px;
    Rectangle {
        x: 10px;
        width: parent.width - 10px;
        background: Theme.text.transparentize(92%);
    }
}

// A settings group: a Mac grouped-form box, a card on Windows (as Cart Setup's).
export component Group inherits Rectangle {
    border-radius: Theme.mac ? 9px : 8px;
    background: Theme.mac ? Theme.text.transparentize(94%) : Theme.card;
    border-width: Theme.mac ? 0px : 1px;
    border-color: Theme.card-border;
    VerticalLayout {
        padding-top: Theme.mac ? 2px : 12px;
        padding-bottom: Theme.mac ? 2px : 12px;
        padding-left: Theme.mac ? 0px : 16px;
        padding-right: Theme.mac ? 0px : 16px;
        spacing: Theme.mac ? 0px : 4px;
        @children
    }
}

// A toggle button (Loop, Play Next, Hold): the accent and bold words when on. Its
// words never wrap.
export component Toggle inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled(bool);
    height: 32px;
    min-width: row.preferred-width;
    border-radius: Theme.mac ? 7px : 4px;
    background: on ? Theme.accent : ta.has-hover ? Theme.hover : Theme.mac ? Theme.text.transparentize(90%) : Theme.control;
    border-width: on || Theme.mac ? 0px : 1px;
    border-color: Theme.control-border;
    accessible-role: checkbox;
    accessible-checked: on;
    accessible-label: text;
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.on ? Theme.on-accent : Theme.text;
            font-weight: root.on ? 600 : 400;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
}

// A 32 px icon-only button, with a 40 px hit area for a finger and a tooltip for a mouse.
component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> destructive;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: destructive ? Theme.danger-edge : Theme.control-border;
    property <color> fill: destructive ? Theme.danger-fill : Theme.control;
    background: ta.pressed ? (Theme.dark ? fill.brighter(30%) : fill.darker(10%))
        : ta.has-hover ? (Theme.dark ? fill.brighter(15%) : fill.darker(5%)) : fill;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        stroke: root.destructive ? Theme.danger-icon : Theme.text;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
    ta := TouchArea {
        x: -4px;
        y: -4px;
        width: 40px;
        height: 40px;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    tip-delay := Timer {
        interval: 600ms;
        running: ta.has-hover && !root.tip-shown && !ta.pressed;
        triggered => {
            root.tip-shown = true;
        }
    }
    property <bool> tip-shown;
    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if !self.hovering {
            self.tip-shown = false;
        }
    }
    if root.tip-shown && ta.has-hover && !ta.pressed: Rectangle {
        y: -self.height - 6px;
        x: (root.width - self.width) / 2;
        width: tip.preferred-width + 16px;
        height: tip.preferred-height + 8px;
        border-radius: 4px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-border;
        tip := Text {
            text: root.label;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component QuickEditPanel inherits Panel {
    in property <QuickEdit> qe;
    callback label(string);
    callback colour(int);
    callback gain(float);
    // "output", "fade" or "group": open its choices at (x, y) in the window.
    callback choice-menu(string, length, length);
    // "loop", "next" or "stop-all".
    callback flag(string, bool);
    // "done", "learn", "clear-key", "copy", "paste", "delete",
    // "gain-reset" or "setup" (Cart Setup).
    callback action(string);

    // The arrow points at the cart: on the left edge (panel right of the cart) or the
    // right edge, this far down.
    in property <bool> arrow-left: true;
    in property <length> arrow-y: 40px;

    // A quick fade in, as the system's popovers do.
    property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity {
        duration: 140ms;
        easing: ease-out;
    }
    init => {
        self.shown = true;
    }

    // As wide as the label column and eight 30 px swatches (4 px apart) need.
    width: 392px;
    height: layout.preferred-height;
    border-radius: Theme.mac ? 12px : 8px;
    background: Theme.popover;
    // The strongest line in the window: it has to read against saturated carts.
    border-color: Theme.popover-edge;

    // Clicks inside the panel must not reach the backdrop (which closes it).
    TouchArea { }

    // The arrow pointing at the cart: its centre at the cart's, clear of the panel's
    // corners, with a small round on the tip that stops just short of the cart. Its stroke
    // meets the panel's edge in a square corner; its fill reaches over that edge, opening
    // it. Drawn from a whole-pixel origin (the panel's edge is a whole number of device
    // pixels, which the line must match).
    in property <float> scale: 1;
    property <float> edge: max(1, round(root.scale)) / root.scale;
    property <float> line: root.arrow-left ? 12 + root.edge / 2 : 4 - root.edge / 2;
    property <string> outline: root.arrow-left
        ? "M" + root.line + " 0v2l-8.8 8.8q-1.2 1.2 0 2.4l8.8 8.8v2"
        : "M" + root.line + " 0v2l8.8 8.8q1.2 1.2 0 2.4l-8.8 8.8v2";
    property <length> arrow-top: clamp(root.arrow-y, 24px, max(24px, root.height - 24px)) - 13px;
    Path {
        x: root.arrow-left ? -12px : root.width - 4px;
        y: root.arrow-top;
        width: 16px;
        height: 26px;
        viewbox-width: 16;
        viewbox-height: 26;
        // Only below the stroke's first and above its last stretch along the edge.
        commands: root.arrow-left
            ? "M" + root.line + " 2l-8.8 8.8q-1.2 1.2 0 2.4l8.8 8.8H16V2Z"
            : "M" + root.line + " 2l8.8 8.8q1.2 1.2 0 2.4l-8.8 8.8H0V2Z";
        fill: Theme.popover;
    }
    Path {
        x: root.arrow-left ? -12px : root.width - 4px;
        y: root.arrow-top;
        width: 16px;
        height: 26px;
        viewbox-width: 16;
        viewbox-height: 26;
        commands: root.outline;
        stroke: Theme.popover-edge;
        stroke-width: root.edge * 1px;
    }

    layout := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 0px;
        // The cart's colour and number.
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 9px;
                background: qe.cart-color;
                border-width: 1px;
                border-color: Theme.text.transparentize(70%);
            }
            Text {
                text: qe.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Label";
            LabelField {
                y: (parent.height - self.height) / 2;
                single-line: true;
                text: qe.label;
                edited(t) => {
                    root.label(t);
                }
            }
        }
        FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Colour";
            // The quick colours, 30 px with 4 px between (any other colour is in Cart
            // Setup).
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for c[i] in qe.swatches: Rectangle {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.mac ? 15px : 4px;
                    background: c;
                    border-width: i == qe.color ? 2px : 0px;
                    border-color: Theme.text;
                    accessible-role: button;
                    accessible-label: "Colour " + (i + 1);
                    TouchArea {
                        clicked => {
                            root.colour(i);
                        }
                    }
                }
            }
        }
        if !qe.control: FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Gain";
            // As tall as a drop-down on Windows, for a finger; a press on the track
            // jumps there and a double-click on the knob goes back to 0 dB.
            gain-slider := SetupSlider {
                y: (parent.height - self.height) / 2;
                centre-mark: true;
                minimum: -12;
                maximum: 12;
                value: qe.gain;
                changed(v) => {
                    root.gain(v);
                }
                reset => {
                    self.value = 0;
                    root.action("gain-reset");
                }
            }
            Text {
                width: 64px;
                // As stored: within ±0.25 dB is exactly 0, else to 0.1 dB. Always one
                // decimal, never "−0".
                property <int> tenths: abs(gain-slider.value) < 0.25 ? 0 : round(gain-slider.value * 10);
                text: self.tenths == 0 ? "0.0 dB" : (self.tenths > 0 ? "+" : "−") + floor(abs(self.tenths) / 10) + "." + mod(abs(self.tenths), 10) + " dB";
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        if !qe.control: FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Output";
            PopButton {
                y: (parent.height - self.height) / 2;
                model: qe.outputs;
                current-index: qe.output;
                warn: qe.output-warn;
                open(x, y) => {
                    root.choice-menu("output", x, y);
                }
            }
        }
        if !qe.control: FieldRow {
            grouped: false;
            label-width: 72px;
            label: Theme.mac ? "Fade Out" : "Fade out";
            PopButton {
                y: (parent.height - self.height) / 2;
                model: qe.fades;
                current-index: qe.fade;
                open(x, y) => {
                    root.choice-menu("fade", x, y);
                }
            }
        }
        if qe.show-group: FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Group";
            PopButton {
                y: (parent.height - self.height) / 2;
                model: qe.groups;
                current-index: qe.group;
                open(x, y) => {
                    root.choice-menu("group", x, y);
                }
            }
        }
        FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Hotkey";
            HorizontalLayout {
                spacing: 8px;
                if qe.learning: Text {
                    text: "Press a key or play a MIDI note…";
                    color: Theme.learning;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // The key in a chip with its ✕.
                if qe.hotkey != "" && !qe.learning: KeyChip {
                    y: (parent.height - self.height) / 2;
                    text: qe.hotkey;
                    clear-label: "Clear Hotkey";
                    clear => {
                        root.action("clear-key");
                    }
                }
                if qe.hotkey == "" && !qe.learning: Text {
                    text: "–";
                    color: Theme.weak-text;
                    vertical-alignment: center;
                }
                if !qe.learning: Rectangle {
                    horizontal-stretch: 1;
                }
                SysButton {
                    y: (parent.height - self.height) / 2;
                    text: qe.learning ? "Cancel" : "Learn";
                    clicked => {
                        root.action("learn");
                    }
                }
            }
        }
        if !qe.control: FieldRow {
            grouped: false;
            label-width: 72px;
            label: "Playback";
            HorizontalLayout {
                spacing: 8px;
                Toggle {
                    y: (parent.height - self.height) / 2;
                    text: "Loop";
                    horizontal-stretch: 1;
                    min-width: 0;
                    preferred-width: 0;
                    on: qe.looping;
                    toggled(on) => {
                        root.flag("loop", on);
                    }
                }
                Toggle {
                    y: (parent.height - self.height) / 2;
                    text: Theme.mac ? "Play Next" : "Play next";
                    horizontal-stretch: 1;
                    min-width: 0;
                    preferred-width: 0;
                    on: qe.next;
                    toggled(on) => {
                        root.flag("next", on);
                    }
                }
            }
        }

        // The actions, below a rule, on the form's grid: Copy and Paste in the label
        // column, Cart setup… on the controls' left edge, Delete on their right edge.
        Rectangle {
            height: 8px;
        }
        Rectangle {
            height: 1px;
            background: Theme.card-border;
        }
        HorizontalLayout {
            padding-top: 12px;
            spacing: 12px;
            HorizontalLayout {
                width: 72px;
                spacing: 8px;
                IconButton {
                    label: "Copy";
                    icon: "M5.5 5.5H13.5V13.5H5.5Z M3 10.5H2.5V2.5H10.5V3";
                    clicked => {
                        root.action("copy");
                    }
                }
                IconButton {
                    label: "Paste";
                    icon: "M5.5 3H3V14H13V3H10.5 M5.5 1.75H10.5V4.5H5.5Z";
                    enabled: qe.can-paste;
                    clicked => {
                        root.action("paste");
                    }
                }
            }
            HorizontalLayout {
                // A control button has nothing to set up.
                if !qe.control: Rectangle {
                    height: 32px;
                    width: setup.preferred-width;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.accent.transparentize(Theme.dark
                        ? (setup-ta.pressed ? 70% : setup-ta.has-hover ? 78% : 86%)
                        : (setup-ta.pressed ? 80% : setup-ta.has-hover ? 86% : 92%));
                    accessible-role: button;
                    accessible-label: "Cart setup";
                    setup := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 8px;
                        Path {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: "M2 5H6.5 M10.5 5H14 M2 11H5.5 M9.5 11H14 M8.5 3.25A1.75 1.75 0 1 0 8.5 6.75A1.75 1.75 0 1 0 8.5 3.25Z M7.5 9.25A1.75 1.75 0 1 0 7.5 12.75A1.75 1.75 0 1 0 7.5 9.25Z";
                            stroke: Theme.accent;
                            stroke-width: 1.4px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            fill: transparent;
                        }
                        Text {
                            text: "Cart setup…";
                            color: Theme.accent;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    setup-ta := TouchArea {
                        y: -4px;
                        height: 40px;
                        clicked => {
                            root.action("setup");
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconButton {
                    label: "Delete";
                    destructive: true;
                    icon: "M2.5 4H13.5 M6 4V2.5H10V4 M4 4L4.8 13.5H11.2L12 4 M6.6 6.5V11 M9.4 6.5V11";
                    clicked => {
                        root.action("delete");
                    }
                }
            }
        }
    }
}
