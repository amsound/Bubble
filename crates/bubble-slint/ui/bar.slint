// The page bar, at the bottom of the window or the top (Settings ▸ General): page tabs
// (click, double-click to rename, drag to reorder, right-click or press-and-hold for
// more), add page, a status line when there is news, then Edit/Show, STOP PAGE and
// STOP ALL. Placed by arithmetic, so nothing is clipped at any bar height.
//
// The tabs are joined to the cart wall: each is the same size, side by side, sharing
// one faint outline with its neighbour and open on the side facing the carts. The page
// shown is in the wall's colour with a thicker outline, so it runs into the wall. A
// page with something playing (not the one shown) has a red corner on the outer edge.

import { Theme, FlatButton, Field } from "theme.slint";

export struct PageTab {
    name: string,
    // Something on the page is playing (a yellow bar along the top).
    playing: bool,
}

export struct StatusItem {
    text: string,
    error: bool,
    // Information, not a warning (audio being prepared).
    info: bool,
}

component Tab inherits Rectangle {
    in property <PageTab> page;
    in property <bool> current;
    in property <length> font-size;
    // The bar is at the top of the window: the carts are below the tab.
    in property <bool> at-top;
    callback select();
    callback rename();
    callback menu(length, length);
    // Dragging: the pointer's x in the tab, and the drop.
    callback drag(length);
    callback drop(length);

    property <bool> dragging;
    property <bool> holding;
    property <bool> held;
    // The outline: thicker on the page shown. Rounded on the outer side only.
    property <length> bw: current ? 2px : 1px;
    property <length> r: 7px;
    background: current ? Theme.window-bg : ta.has-hover ? Theme.hover : Theme.bar-bg;
    border-width: bw;
    border-color: current ? Theme.text.transparentize(30%) : Theme.text.transparentize(82%);
    border-top-left-radius: at-top ? r : 0;
    border-top-right-radius: at-top ? r : 0;
    border-bottom-left-radius: at-top ? 0 : r;
    border-bottom-right-radius: at-top ? 0 : r;
    clip: true;
    // No outline on the side facing the carts: the tab opens into the wall.
    Rectangle {
        x: root.bw;
        y: root.at-top ? parent.height - root.bw : 0;
        width: parent.width - 2 * root.bw;
        height: root.bw;
        background: root.background;
    }
    // Something is playing on this page (not the one shown): a red corner on the
    // outer edge. The name never moves.
    if page.playing && !root.current: Path {
        x: 0;
        y: root.at-top ? 0 : parent.height - self.height;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.at-top ? "M0 0L12 0L0 12Z" : "M0 0L12 12L0 12Z";
        fill: Theme.error;
    }
    Text {
        x: 6px;
        width: parent.width - 12px;
        text: page.name;
        color: Theme.text;
        font-size: root.font-size;
        font-weight: root.current ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Timer {
        interval: 500ms;
        running: root.holding;
        triggered => {
            root.holding = false;
            root.held = true;
            root.menu(ta.mouse-x, ta.mouse-y);
        }
    }
    ta := TouchArea {
        double-clicked => {
            root.rename();
        }
        moved => {
            if self.pressed && !root.held {
                if !root.dragging && abs(self.mouse-x - self.pressed-x) > 8px {
                    root.dragging = true;
                    root.holding = false;
                }
                if root.dragging {
                    root.drag(self.mouse-x);
                }
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if e.button == PointerEventButton.right {
                    root.menu(self.mouse-x, self.mouse-y);
                } else if e.button == PointerEventButton.left {
                    root.dragging = false;
                    root.held = false;
                    root.holding = e.touch-finger-id != 0;
                }
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if root.dragging {
                    root.drop(self.mouse-x);
                } else if !root.held {
                    root.select();
                }
                root.dragging = false;
                root.holding = false;
                root.held = false;
            } else if e.kind == PointerEventKind.cancel {
                root.dragging = false;
                root.holding = false;
                root.held = false;
            }
        }
    }
}

export component BottomBar inherits Rectangle {
    in property <[PageTab]> pages;
    in property <int> current;
    in property <bool> edit-mode;
    in property <[StatusItem]> status;
    // The page being renamed (-1: none) and its name when the rename began.
    in property <int> renaming: -1;
    in property <string> rename-text;
    // Missing files are listed in the status: clicking it opens Relink.
    in property <bool> status-clickable;

    callback toggle-mode();
    callback select-page(int);
    callback start-rename(int);
    callback renamed(int, string);
    callback page-menu(int, length, length);
    callback move-page(int, int);
    callback add-page();
    callback stop-page();
    callback stop-all();
    callback status-clicked();

    background: Theme.bar-bg;

    // One physical pixel (1px / the window's scale): tabs sit on whole pixels, so
    // their names stay sharp at 125% and 150%.
    in property <length> unit: 1px;
    // At the top of the window (the carts below it), not the bottom.
    in property <bool> at-top;

    property <length> m: 5px;
    property <length> gap: 6px;
    property <length> btn-h: max(20px, self.height - 2 * m);
    // Sizes from the design (Small 44, Medium 64, Large 92 px), in between by line.
    property <length> grow: max(0px, self.height - 44px);
    property <length> text: min(13px + grow * 0.104, 20px);
    property <length> stop-text: min(14px + grow * 0.167, 24px);
    // As wide as their words plus a little padding (never narrower than Edit/Show).
    property <length> stop-w: max(stop-btn.preferred-width, mode-w);
    property <length> page-w: max(page-btn.preferred-width, mode-w);
    property <length> mode-w: 56px + grow * 1.125;
    // Edit/Show, STOP PAGE and STOP ALL on the right; the tabs from the left up to them.
    property <length> mode-x: self.width - m - stop-w - gap - page-w - gap - mode-w;
    property <length> right: mode-x - gap;
    property <length> tabs-x: m;
    property <length> status-w: status.length == 0 ? 0px : (right - tabs-x) * 0.35;
    property <length> plus-w: edit-mode ? min(btn-h, 40px) + gap : 0px;
    property <length> tabs-avail: max(40px, right - status-w - gap - tabs-x - plus-w);
    // Tabs overlap by a pixel, so neighbours share one outline.
    property <length> tab-w: floor(clamp((tabs-avail + (pages.length - 1) * 1px) / max(pages.length, 1), 24px, 112px + grow * 1.17) / unit) * unit;
    property <length> step: tab-w - 1px;
    // The tabs run from the edge facing the carts to the bar's margin on the far side.
    property <length> tab-y: at-top ? m : 0px;
    property <length> tab-h: self.height - m;
    // Where a dragged tab would land (-1: not dragging).
    property <int> drag-from: -1;
    property <int> drag-to: -1;

    // The faint line along the edge facing the carts (the tab shown covers it).
    Rectangle {
        y: root.at-top ? parent.height - 1px : 0;
        width: parent.width;
        height: 1px;
        background: Theme.text.transparentize(82%);
    }

    // Edit/Show, beside the stops.
    FlatButton {
        x: mode-x;
        y: m;
        width: mode-w;
        height: btn-h;
        text: edit-mode ? "EDIT" : "SHOW";
        fill: edit-mode ? Theme.edit-mode : Theme.show-mode;
        text-color: #ffffff;
        font-size: text;
        clicked => {
            root.toggle-mode();
        }
    }

    for p[i] in pages: Rectangle {
        // The page shown is drawn over its neighbours (its thicker outline wins), and a
        // pixel into the line facing the carts, which it hides.
        z: i == root.current ? 1 : 0;
        x: round((tabs-x + i * step) / unit) * unit;
        y: i == root.current && !root.at-top ? -1px : round(tab-y / unit) * unit;
        width: tab-w;
        height: round(tab-h / unit) * unit + (i == root.current ? 1px : 0px);
        if i != root.renaming: Tab {
            page: p;
            current: i == root.current;
            at-top: root.at-top;
            font-size: text;
            select => {
                root.select-page(i);
            }
            rename => {
                root.start-rename(i);
            }
            menu(x, y) => {
                root.page-menu(i, parent.x + x, parent.y + y);
            }
            drag(x) => {
                root.drag-from = i;
                root.drag-to = clamp(floor((parent.x + x - tabs-x + step / 2) / step), 0, pages.length);
            }
            drop(x) => {
                if root.drag-to >= 0 {
                    root.move-page(i, root.drag-to > i ? root.drag-to - 1 : root.drag-to);
                }
                root.drag-from = -1;
                root.drag-to = -1;
            }
        }
        if i == root.renaming: Field {
            // The whole tab, so the name being typed is visible.
            width: parent.width;
            height: parent.height;
            text: root.rename-text;
            font-size: text;
            min-width: 0;
            init => {
                self.focus();
                self.select-all();
            }
            accepted(t) => {
                root.renamed(i, t);
            }
            focus-changed(f) => {
                if !f && root.renaming == i {
                    root.renamed(i, self.text);
                }
            }
        }
    }
    // Where a dragged tab will land.
    if drag-from >= 0 && drag-to >= 0: Rectangle {
        z: 2;
        x: tabs-x + drag-to * step - 1.5px;
        y: tab-y;
        width: 3px;
        height: tab-h;
        background: Theme.select;
    }
    // Add page: just the +, no outline.
    if edit-mode: FlatButton {
        x: tabs-x + pages.length * step + gap;
        y: m;
        width: min(btn-h, 40px);
        height: btn-h;
        text: "+";
        fill: transparent;
        text-color: Theme.text;
        bold: false;
        font-size: text + 6px;
        clicked => {
            root.add-page();
        }
    }

    // Status line, only when there is something to say.
    if status.length > 0: Rectangle {
        x: right - status-w;
        y: m;
        width: status-w;
        height: btn-h;
        clip: true;
        HorizontalLayout {
            alignment: end;
            spacing: 0;
            for s[i] in status: HorizontalLayout {
                if i > 0: Text {
                    text: "  ·  ";
                    font-size: 12px;
                    color: Theme.weak-text;
                    vertical-alignment: center;
                }
                Text {
                    text: s.text;
                    font-size: 12px;
                    color: s.error ? Theme.error : s.info ? Theme.weak-text : Theme.warn;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        TouchArea {
            enabled: root.status-clickable;
            mouse-cursor: root.status-clickable ? pointer : default;
            clicked => {
                root.status-clicked();
            }
        }
    }

    page-btn := FlatButton {
        x: root.width - m - stop-w - gap - page-w;
        y: m;
        width: page-w;
        height: btn-h;
        text: "■ PAGE STOP";
        font-size: text;
        clicked => {
            root.stop-page();
        }
    }
    stop-btn := FlatButton {
        x: root.width - m - stop-w;
        y: m;
        width: stop-w;
        height: btn-h;
        text: "■ ALL STOP";
        fill: Theme.stop-all;
        text-color: #ffffff;
        font-size: stop-text;
        clicked => {
            root.stop-all();
        }
    }
}
